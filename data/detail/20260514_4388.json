す。", null, "CurrentYearDuration"], ["ExplanationOfMeasurementsOfSalesProfitLossAssetLiabilityAndOtherItemsForEachReportableSegmentTextBlock", "ExplanationOfMeasurementsOfSalesProfitLossAssetLiabilityAndOtherItemsForEachReportableSegmentTextBlock", "jpcrp_cor", "当期", null, "２．報告セグメントごとの売上高、利益又は損失、資産、負債その他の項目の金額の算定方法報告されている事業セグメントの会計処理の方法は、連結財務諸表を作成するために採用される会計方針に準拠した方法であります。報告セグメントの利益は、営業利益ベースの数値であります。セグメント間の内部収益及び振替高は市場実勢価格に基づいております。", null, "CurrentYearDuration"], ["RevenuesFromExternalCustomers", "RevenuesFromExternalCustomers", "jpcrp_cor", "前期", 1160434000, "1,160,434", "JPY", "Prior1YearDuration_tse-acedjpfr-43880VoiceRelatedBusinessReportableSegmentMember"], ["RevenuesFromExternalCustomers", "RevenuesFromExternalCustomers", "jpcrp_cor", "前期", 288933000, "288,933", "JPY", "Prior1YearDuration_tse-acedjpfr-43880DigitalMarketingReportableSegmentMember"], ["RevenuesFromExternalCustomers", "RevenuesFromExternalCustomers", "jpcrp_cor", "前期", 36669000, "36,669", "JPY", "Prior1YearDuration_OtherReportableSegmentsMember"], ["RevenuesFromExternalCustomers", "RevenuesFromExternalCustomers", "jpcrp_cor", "前期", 1486037000, "1,486,037", "JPY", "Prior1YearDuration_ReportableSegmentsMember"], ["RevenuesFromExternalCustomers", "RevenuesFromExternalCustomers", "jpcrp_cor", "前期", 1486037000, "1,486,037", "JPY", "Prior1YearDuration"], ["TransactionsWithOtherSegments", "TransactionsWithOtherSegments", "jpcrp_cor", "前期", 375000, "375", "JPY", "Prior1YearDuration_tse-acedjpfr-43880DigitalMarketingReportableSegmentMember"], ["TransactionsWithOtherSegments", "TransactionsWithOtherSegments", "jpcrp_cor", "前期", 375000, "375", "JPY", "Prior1YearDuration_ReportableSegmentsMember"], ["TransactionsWithOtherSegments", "TransactionsWithOtherSegments", "jpcrp_cor", "前期", -375000, "375", "JPY", "Prior1YearDuration_ReconcilingItemsMember"], ["売上高", "NetSales", "jppfs_cor", "前期", 1160434000, "1,160,434", "JPY", "Prior1YearDuration_tse-acedjpfr-43880VoiceRelatedBusinessReportableSegmentMember"], ["