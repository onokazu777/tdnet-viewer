l, "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "予想", 3356000000, "3,356", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "予想", 660000000, "660", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "予想", 651000000, "651", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ProfitAttributableToOwnersOfParent", "ProfitAttributableToOwnersOfParent", "tse-ed-t", "予想", 428000000, "428", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "予想", 77.78, "77.78", "JPYPerShares", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["NoteToFinancialForecast", "NoteToFinancialForecast", "tse-ed-t", "当期", null, "（注）当社は2026年３月23日開催の取締役会決議に基づき、自己株式の取得を行っております。連結業績予想の「１株当たり当期純利益」については、当該自己株式取得の影響を考慮し、算定しております。公表済み予想（単体）(B)は、親会社株主に帰属する当期純利益ではなく、当期純利益の数値を記載しております。", null, "CurrentYearDuration"], ["FiscalYearEnd", "FiscalYearEnd", "tse-ed-t", "当期末", null, "2026-12-31", null, "CurrentYearInstant"]]}}