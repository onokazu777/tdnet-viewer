.043, "4.3", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOperatingIncome", "ChangeInOperatingIncome", "tse-ed-t", "予想", 0.236, "23.6", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOrdinaryIncome", "ChangeInOrdinaryIncome", "tse-ed-t", "予想", 0.237, "23.7", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInNetIncome", "ChangeInNetIncome", "tse-ed-t", "予想", -0.501, "50.1", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "前期", 86600000000, "86,600", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "前期", 3911000000, "3,911", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "前期", 3922000000, "3,922", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["NetIncome", "NetIncome", "tse-ed-t", "前期", 3596000000, "3,596", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "前期", 344.71, "344.71", "JPYPerShares", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForForecastCorrection", "ReasonForForecastCorrection", "tse-ed-t", "当期", null, "（連結業績予想）売上高につきましては、当期の受注が好調であったことに加え、手持ち工事の進捗が順調に推移したことにより、前回予想を上回る見込みです。利益面につきましては、売上高の増加に加え、粗利益率の向上、並びに販売費及び一般管理費の削減により、営業利益及び経常利益は前回予想を上回る見込みです。親会社株主に帰属する当期純利益は、株式会社神島組（以下、「神島組」といいます。）に係る技術関連資産等の減損損失を計上した一方で、営業利益及び経常利益の上方修正により、前回予想を上回る見込みです。（個別業績予想）　売上高、営業利益、経常利益につきましては、連結業績予想と同様の理由により修正いたします。当期純利益につきましては、神島組の株式の実質価額が著しく低下したため、関係会社株式評価損を計上したことにより、前回予想を下回る見込みです。", null, "CurrentYearDuration"], ["PreviousReportingDateOfDividendForecast", "PreviousReportingDateOfDividendForecast", "tse-ed-t", "当期末", null, "（2025年10月24日発表）", null, "CurrentYearInstant_AnnualMember_NonConsolidatedMember_PreviousMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 87, "87.00", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 174, "174.00", "JPYPerShares", "CurrentYearDuration_AnnualMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 96, "96.00", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 183, "183.00", "JPYPerShares", "CurrentYearDuration_AnnualMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "当期", 87, "87.00", "JPYPerShares", "CurrentYearDuration_SecondQuarterMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 44.5, "44.50", "JPYPerShares", "PriorYearDuration_SecondQuarterMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 54.5, "54.50", "JPYPerShares", "PriorYearDuration_YearEndMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 99, "99.00", "JPYPerShares", "PriorYearDuration_AnnualMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForDividendForecastCorrection", "ReasonForDividendForecastCorrection", "tse-ed-t", "当期", null, "当社は、更なる企業価値の向上に向けて積極的な成長投資と安定的な株主還元を行うという考えのもと、2025年３月期より総還元性向50％以上かつＤＯＥ4.0％以上とすることを基本方針としております。　この方針のもと、2026年３月期の期末配当予想を１株当たり87円から９円増配の96円に修正することといたしました。なお、当期の年間配当金は、１株当たり183円、配当性向は50.06％となる見込みです。特別損失（減損損失）の計上見込みについて　当社の連結子会社である神島組に係る技術関連資産等の固定資産について、営業網の拡大や施工体制の強化といった、同社の業績平準化に向けた施策による効果発現の遅れ等に伴い、今後の事業計画を慎重に見直した結果、連結決算において減損損失約14億円を計上する見込みとなりました。　また、これにより神島組の株式の実質価額が著しく低下したため、当社個別決算において、関係会社株式評価損約28億円を計上する見込みとなりました。なお、当該関係会社株式評価損は連結決算上消去されるため、連結業績への影響はございません。（注）本資料に記載されている特別損失額については、現在、会計監査人による監査手続が完了していないため、当社の見込みを記載しており、実際の損失額は予想数値と異なる場合があります。また、上記の予想は、本資料の発表日現在において入手可能な情報に基づき作成したものであり、実際の業績は今後の様々な要因によって予想と異なる可能性があります。", null, "CurrentYearDuration"], ["FiscalYearEnd", "FiscalYearEnd", "tse-ed-t", "当期末", null, "2026-03-31", null, "CurrentYearInstant"]]}}