naryIncome", "ChangeInOrdinaryIncome", "tse-ed-t", "予想", 0.197, "19.7", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInNetIncome", "ChangeInNetIncome", "tse-ed-t", "予想", -0.055, "5.5", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "前期", 8915000000, "8,915", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "前期", 1693000000, "1,693", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "前期", 1696000000, "1,696", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["NetIncome", "NetIncome", "tse-ed-t", "前期", 1150000000, "1,150", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "前期", 53.25, "53.25", "JPYPerShares", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForForecastCorrection", "ReasonForForecastCorrection", "tse-ed-t", "当期", null, "売上高の差異につきましては、第4四半期に売上計上を予定していた国内向けの大型案件について、出荷までは予定通り完了していたものの、その後の客先工場における現地調整に時間を要し2026年8月末までに一部装置の検収が完了しなかったことを主な要因として、減収となる見通しです。それに加え、米国主要顧客向け太陽電池製造装置の改造案件の一部において、並行して行われている大規模な装置の移設作業を優先したことから、2027年8月期への期ずれが発生したことも要因となっています。なお、前述した国内向けの大型案件の一部に関しては、2027年8月期上期に検収が完了する予定であり、期ずれした売上高は同上期に計上される見込みです。減収の一方、利益率の高い案件（移設・改造）があったことに加え、新技術や開発要素を含む案件において原価に占める割合の高い材料費を大幅に削減したことで、営業利益及び経常利益は微増となる見通しです。また、親会社株主に帰属する当期純利益に関しては、2026年3月に発表したGosan Tech社への出資に関連して取得した株式について、特別損失として投資有価証券評価損177百万円を計上することとなりました。なお、この特別損失は出資者側である当社に適用される会計ルールに基づく処理によるものであります。また、本出資の主目的である「ペロブスカイト前工程における当社業績の拡大」に向けては、既に投資額を上回る受注を獲得しており、事業は順調に推移しております。配当予想につきましては、売上の減少と特別損失の計上は一時的なものであり、事業環境そのものへの影響は生じていないため、期末配当については当初の予定通り１株当たり10円を維持する方針です。なお、現時点における2027年8月期の業績予想は売上高約100億円、営業利益は約13億円を見込んでおります。精査した金額につきましては、2026年10月7日に改めて公表する予定です。（注）上記予想は、発表日現在において入手可能な情報に基づいて作成しております。実際の業績は、今後様々 な要因によって予想数値と異なる可能性があります。", null, "CurrentYearDuration"], ["FiscalYearEnd", "FiscalYearEnd", "tse-ed-t", "当期末", null, "2026-08-31", null, "CurrentYearInstant"]]}}