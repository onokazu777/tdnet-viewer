sOfParent", "tse-ed-t", "予想", 1100000000, "1,100", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInNetSales", "ChangeInNetSales", "tse-ed-t", "予想", 0.06200000000000001, "6.2", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOperatingIncome", "ChangeInOperatingIncome", "tse-ed-t", "予想", 0.193, "19.3", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOrdinaryIncome", "ChangeInOrdinaryIncome", "tse-ed-t", "予想", 0.227, "22.7", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInProfitAttributableToOwnersOfParent", "ChangeInProfitAttributableToOwnersOfParent", "tse-ed-t", "予想", 0.167, "16.7", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "前期", 65878000000, "65,878", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "前期", 8153000000, "8,153", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "前期", 8000000000, "8,000", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["ProfitAttributableToOwnersOfParent", "ProfitAttributableToOwnersOfParent", "tse-ed-t", "前期", 6595000000, "6,595", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "前期", 185.16, "185.16", "JPYPerShares", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForForecastCorrection", "ReasonForForecastCorrection", "tse-ed-t", "当期", null, "【第2四半期（中間期）連結業績予想数値の修正】SS事業において、米国でのデータセンター等の大型重要施設向け防犯センサーおよび日本・米国での駐車場向けソリューションの販売が好調に推移したことに加え、IA事業においてもAI関連需要を背景に、半導体・電気・電子関連業界向けのFAセンサーおよび検査用照明の販売が好調に推移しました。また、両事業における高付加価値製品の販売拡大により収益性が向上した結果、売上高、営業利益、経常利益および親会社株主に帰属する中間純利益は前回予想を上回る見込みとなりました。【通期連結業績予想数値の修正】第2四半期（中間期）までの業績が当初計画を上回って推移していることを踏まえ、足元の受注動向および事業環境を勘案し、通期連結業績予想を修正いたします。SS事業におけるデータセンター等の大型重要施設向け防犯センサーおよび駐車場向けソリューション、IA事業におけるFAセンサーおよび検査用照明の販売が好調に推移していることに加え、高付加価値製品の販売拡大による収益性向上が寄与し、各利益項目は前回予想を上回る見込みです。なお、通期連結業績予想の前提となる第３四半期以降の想定為替レートにつきましては、最近の為替相場の動向を踏まえ、米ドルは当初予想の150円から155円、ユーロは175円から180円に変更しております。", null, "CurrentYearDuration"], ["PreviousReportingDateOfDividendForecast", "PreviousReportingDateOfDividendForecast", "tse-ed-t", "当期末", null, "（2026年2月13日発表）", null, "CurrentYearInstant_AnnualMember_NonConsolidatedMember_PreviousMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 32.5, "32.50", "JPYPerShares", "CurrentYearDuration_SecondQuarterMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 32.5, "32.50", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 65, "65.00", "JPYPerShares", "CurrentYearDuration_AnnualMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 38, "38.00", "JPYPerShares", "CurrentYearDuration_SecondQuarterMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 38, "38.00", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 76, "76.00", "JPYPerShares", "CurrentYearDuration_AnnualMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 25, "25.00", "JPYPerShares", "PriorYearDuration_SecondQuarterMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 31, "31.00", "JPYPerShares", "PriorYearDuration_YearEndMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 56, "56.00", "JPYPerShares", "PriorYearDuration_AnnualMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForDividendForecastCorrection", "ReasonForDividendForecastCorrection", "tse-ed-t", "当期", null, "当社は、株主の皆様に対する利益還元を重要な経営課題の一つであると位置付けております。配当方針につきましては、株主の皆様へのより安定的で継続的な配当を実現させるため、収益状況に裏付けられた成果の配分を行うことを基本に、将来への事業展開に備えた財務基盤の強化を考慮しつつ、連結配当性向35％を目安にDOE（連結株主資本配当率）3.5％以上を実現することとしております。上記の方針及び当期の業績予想を踏まえ、2026年12月期の第2四半期および期末配当につきましては、前回予想から1株当たり其々５円50銭増額し、38円といたします。これに伴い、年間配当は前回予想の1株当たり65円から11円増額の76円となります。", null, "CurrentYearDuration"], ["FiscalYearEnd", "FiscalYearEnd", "tse-ed-t", "当期末", null, "2026-12-31", null, "CurrentYearInstant"]]}}