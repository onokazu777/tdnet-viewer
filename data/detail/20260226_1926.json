ation"], ["PreviousReportingDateOfDividendForecast", "PreviousReportingDateOfDividendForecast", "tse-ed-t", "当期末", null, "（2025年５月14日発表）", null, "CurrentYearInstant_AnnualMember_NonConsolidatedMember_PreviousMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 67, "67.00", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 107, "107.00", "JPYPerShares", "CurrentYearDuration_AnnualMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 78, "78.00", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 118, "118.00", "JPYPerShares", "CurrentYearDuration_AnnualMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "当期", 40, "40.00", "JPYPerShares", "CurrentYearDuration_SecondQuarterMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 30, "30.00", "JPYPerShares", "PriorYearDuration_SecondQuarterMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 70, "70.00", "JPYPerShares", "PriorYearDuration_YearEndMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 100, "100.00", "JPYPerShares", "PriorYearDuration_AnnualMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForDividendForecastCorrection", "ReasonForDividendForecastCorrection", "tse-ed-t", "当期", null, "当社は、中期経営計画「Raito 2027」において、財務資本政策の基本方針として「持続的成長を支える成長投資と最適資本構成の実現」を掲げております。本方針のもと、中期経営計画期間中の株主還元については、実質的総還元性向100％程度の水準を志向し、自己資本の圧縮と資本効率の向上を推進してまいります。配当につきましては、中期経営計画期間中は「累進配当」を継続し、「配当性向 50%以上」とあわせて、最終年度（2027年度）には「DOE（株主資本配当率） 6%以上」の達成を目標としています。 この中期経営計画の方針および目標に基づき、本日の業績予想の修正を踏まえ、期末配当金を前回予想の67円から11円引き上げ、１株当たり年間配当金を中間配当金40円と合わせて118円（連結配当性向50.0％）といたします。（注）上記の業績予想は、本資料の発表日現在において入手可能な情報に基づき作成したものであり、実際の業績等は今後の様々な要因によって予想数値と異なる場合があります。", null, "CurrentYearDuration"], ["FiscalYearEnd", "FiscalYearEnd", "tse-ed-t", "当期末", null, "2026-03-31", null, "CurrentYearInstant"]]}}