000, "325", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInNetSales", "ChangeInNetSales", "tse-ed-t", "予想", -0.069, "6.9", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOperatingIncome", "ChangeInOperatingIncome", "tse-ed-t", "予想", -0.394, "39.4", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOrdinaryIncome", "ChangeInOrdinaryIncome", "tse-ed-t", "予想", -0.394, "39.4", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "前期", 2137000000, "2,137", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "前期", 358000000, "358", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "前期", 368000000, "368", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["ProfitAttributableToOwnersOfParent", "ProfitAttributableToOwnersOfParent", "tse-ed-t", "前期", 129000000, "129", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "前期", 80.18, "80.18", "JPYPerShares", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForForecastCorrection", "ReasonForForecastCorrection", "tse-ed-t", "当期", null, "連結売上高に関して、新規投資事業セグメントにおいて、株式会社KIKAN flexが開発するソフトウェアのリリース時期の延期並びにatBグループのバングラデシュでの求人メディアの有料獲得求人の獲得に苦戦した結果、当初予想110百万円を106百万円下回る見込みであります。また、ポーターズセグメント事業においても、株式会社KIKAN flexのリリース延期に伴うポーターズの導入の消滅及び納品の翌期への後ろ倒しにより、新規顧客のID計画が当初予想を下回り、当初予想2,358百万円を62百万円下回る見込みであります。以上のことから、連結売上高は前回予想を169百万円下回る見込みとなりました。利益面に関して、ソフトウェアのリリース時期の延期により減価償却費などの売上原価が減少したものの、売上の減少に伴う連結営業利益への影響により、連結営業利益及び連結経常利益は前回予想を下回る見込みであります。これに加えて、第3四半期連結会計期間において、「３．特別損失の計上見込み」に記載した特別損失を計上する見込みのため、親会社株主に帰属する当期純利益段階では、減益の見込みとなっております。", null, "CurrentYearDuration"], ["FiscalYearEnd", "FiscalYearEnd", "tse-ed-t", "当期末", null, "2026-12-31", null, "CurrentYearInstant"]]}}