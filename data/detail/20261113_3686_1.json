es", "tse-ed-t", "予想", -0.454, "45.4", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "前期", 1463000000, "1,463", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "前期", -595000000, "595", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "前期", -595000000, "595", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["ProfitAttributableToOwnersOfParent", "ProfitAttributableToOwnersOfParent", "tse-ed-t", "前期", -497000000, "497", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "前期", -11.53, "11.53", "JPYPerShares", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForForecastCorrection", "ReasonForForecastCorrection", "tse-ed-t", "当期", null, "当社グループは、2027年３月期において、「オルタナティブ・アニメ」及びAI関連事業の受注拡大による売上及び利益の増加を見込んでおりました。しかしながら、当中間連結会計期間において、これらの事業の受注獲得が当初の想定を下回り、業績は計画を下回って推移しております。　このような状況を踏まえ、足元の受注状況及び各案件の進捗状況に基づき、下期の売上見込みを見直した結果、当初予想に織り込んでいた売上の達成は困難と判断し、通期の売上高を当初予想の1,740百万円から950百万円に修正いたします。　利益面につきましても、上記の売上見込みの減少を踏まえ、営業利益及び経常利益をそれぞれ100百万円の利益から260百万円の損失に、親会社株主に帰属する当期純利益を150百万円の利益から120百万円の損失に修正いたします。　一方、アニメーション制作では新規作品及び既存シリーズの継続制作の実績を積み重ねており、AI関連事業においても、AIを利用して制作された作品の受注・納入実績の積み上がりに加えて、広報動画生成サービス「しゃべくりAI」における初期導入及び月額利用によるサービス収入が発生するなど、事業展開に具体的な進展が見られております。また、制作作品の商品化や販売パートナーとの連携を進め、来期以降の収益拡大に向けた基盤の整備に取り組んでおります。　2028年３月期に向けては、これらの制作実績及び販売基盤を活用した受注拡大と、IP及びAI関連サービスによる収益機会の拡大を図ってまいります。（注）予想数値は、現時点で入手可能な情報に基づき算出したものであり、実際の業績は、今後の様々な要因により異なる場合があります。", null, "CurrentYearDuration"], ["FiscalYearEnd", "FiscalYearEnd", "tse-ed-t", "当期末", null, "2027-03-31", null, "CurrentYearInstant"]]}}