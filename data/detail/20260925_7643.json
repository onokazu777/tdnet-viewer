ることとし、減損損失として1,326百万円を特別損失に計上することといたしました。　今回の減損処理により財務体質の健全化と収益性の改善を図り、来年度以降の積極的な戦略展開に繋げ、当社の持続的な成長の実現に取組んでまいります。　なお、当該損失は主として会計上の減損処理によるものであり、キャッシュ・フローへの直接的な影響はありません。", null, "CurrentYearInstant"], ["売上高", "NetSales", "tse-ed-t", "予想", 61500000000, "61,500", "JPY", "CurrentYearDuration_NonConsolidatedMember_PreviousMember_ForecastMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "予想", 1680000000, "1,680", "JPY", "CurrentYearDuration_NonConsolidatedMember_PreviousMember_ForecastMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "予想", 1630000000, "1,630", "JPY", "CurrentYearDuration_NonConsolidatedMember_PreviousMember_ForecastMember"], ["NetIncome", "NetIncome", "tse-ed-t", "予想", 1200000000, "1,200", "JPY", "CurrentYearDuration_NonConsolidatedMember_PreviousMember_ForecastMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "予想", 106.84, "106.84", "JPYPerShares", "CurrentYearDuration_NonConsolidatedMember_PreviousMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "予想", 61500000000, "61,500", "JPY", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "予想", 1560000000, "1,560", "JPY", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "予想", 1530000000, "1,530", "JPY", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["NetIncome", "NetIncome", "tse-ed-t", "予想", 200000000, "200", "JPY", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "予想", 17.8, "17.80", "JPYPerShares", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["AmountChangeNetSales", "AmountChangeNetSales", "tse-ed-t", "予想", 0, "0", "JPY", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["AmountChangeOperatingIncome", "AmountChangeOperatingIncome", "tse-ed-t", "予想", -120000000, "120", "JPY", "CurrentYearDuration_No