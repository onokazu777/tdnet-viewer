1", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInNetIncome", "ChangeInNetIncome", "tse-ed-t", "予想", 0.359, "35.9", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "前期", 34528000000, "34,528", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["NetIncome", "NetIncome", "tse-ed-t", "前期", 34020000000, "34,020", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "前期", 194.51, "194.51", "JPYPerShares", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForForecastCorrection", "ReasonForForecastCorrection", "tse-ed-t", "当期", null, "2027年3月期第2四半期（累計）（以下、「当中間期」といいます）の個別業績については、本業であるローンビジネスの新規実行及び金利上昇の織り込みが順調に推移したこと等により、前回発表予想を上回るコア業務粗利益が見込まれます。また、費用については、第1四半期に実施した一棟収益不動産ローンの不動産担保評価方法の変更に伴う貸倒引当金の戻入益が想定を上回ったことに加え、これまでに実施した予防的引当の影響等により、実質与信費用が前回発表予想を下回る見通しであり、業績予想を上方修正するものです。また、2027年3月期通期（以下、「当期」といいます）の個別業績についても、当中間期までの好調な業績推移に加え、今後の金融経済環境や業績動向等を勘案し、業績予想を上方修正することといたしました。なお、税負担率については、当中間期が15％程度、当期が20％程度を見込んでおります。連結業績予想の修正は、主に個別業績予想の修正によるものです。", null, "CurrentYearDuration"], ["PreviousReportingDateOfDividendForecast", "PreviousReportingDateOfDividendForecast", "tse-ed-t", "当期末", null, "（2026年5月14日発表）", null, "CurrentYearInstant_AnnualMember_NonConsolidatedMember_PreviousMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 30, "30.00", "JPYPerShares", "CurrentYearDuration_SecondQuarterMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 30, "30.00", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 60, "60.00", "JPYPerShares", "CurrentYearDuration_AnnualMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPer