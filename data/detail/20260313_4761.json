させる環境が整ったものと判断し、連結配当性向50％水準に引き上げ、2026年３月期の期末配当予想を17円から14円増配し、31円に修正いたします。この結果、2026年３月期の年間配当金は実施済みの中間配当金17円と合わせて、1株当たり48円となり、前期比16円の増配となります。なお、本件期末配当につきましては、2026年６月開催予定の第58期定時株主総会に付議する予定です。", null, "CurrentYearDuration"], ["PreviousReportingDate", "PreviousReportingDate", "tse-ed-t", "当期末", null, "2026年1月29日", null, "CurrentYearInstant"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 17, "17.00", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 34, "34.00", "JPYPerShares", "CurrentYearDuration_AnnualMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 31, "31.00", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 48, "48.00", "JPYPerShares", "CurrentYearDuration_AnnualMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "当期", 17, "17.00", "JPYPerShares", "CurrentYearDuration_SecondQuarterMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 12, "12.00", "JPYPerShares", "PriorYearDuration_SecondQuarterMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 20, "20.00", "JPYPerShares", "PriorYearDuration_YearEndMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 32, "32.00", "JPYPerShares", "PriorYearDuration_AnnualMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["FiscalYearEnd", "FiscalYearEnd", "tse-ed-t", "当期末", null, "2026-03-31", null, "CurrentYearInstant"]]}}