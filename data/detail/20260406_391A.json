ember"], ["AmountChangeProfitAttributableToOwnersOfParent", "AmountChangeProfitAttributableToOwnersOfParent", "tse-ed-t", "予想", 67000000, "67", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInNetSales", "ChangeInNetSales", "tse-ed-t", "予想", -0.028, "2.8", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOperatingIncome", "ChangeInOperatingIncome", "tse-ed-t", "予想", 0.175, "17.5", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOrdinaryIncome", "ChangeInOrdinaryIncome", "tse-ed-t", "予想", 0.145, "14.5", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInProfitAttributableToOwnersOfParent", "ChangeInProfitAttributableToOwnersOfParent", "tse-ed-t", "予想", 0.145, "14.5", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "前期", 5438000000, "5,438", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "前期", 690000000, "690", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "前期", 611000000, "611", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["ProfitAttributableToOwnersOfParent", "ProfitAttributableToOwnersOfParent", "tse-ed-t", "前期", 817000000, "817", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "前期", 758.45, "758.45", "JPYPerShares", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForForecastCorrection", "ReasonForForecastCorrection", "tse-ed-t", "当期", null, "１．売上高について　ビジネスホテル事業においては、インバウンド需要の増大により客室単価及び客室稼働率が想定 を上回ったことでプラスの影響がありました。一方、インベストメント事業及びソリューション事業においては、売上総利益率の比較的高い物件の販売に注力したことにより販売件数が想定を下回ったことでマイナスの影響がありました。　これらを総合的に判断した結果、売上高については、前回予想を下回る見込みとなったため下方修正することといたしました。２．営業利益・経常利益について　インベストメント事業及びソリューション事業においては、上記１．に記載のとおり売上総利益率が比較的高い物件の引渡しがなされております。また、ビジネスホテル事業においては、売上原価、販売促進費・広告宣伝費の抑制が図れております。なお、懸念されていた金利上昇についても、その影響を大きく受けることなく支払利息を抑制できております。　これらを総合的に判断した結果、営業利益・経常利益については、前回予想を上回る見込みとなったため上方修正することといたしました。", null, "CurrentYearDuration"], ["PreviousReportingDateOfDividendForecast", "PreviousReportingDateOfDividendForecast", "tse-ed-t", "当期末", null, "（2025年７月29日発表）", null, "CurrentYearInstant_AnnualMember_NonConsolidatedMember_PreviousMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 0, "0.00", "JPYPerShares", "CurrentYearDuration_FirstQuarterMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 0, "0.00", "JPYPerShares", "CurrentYearDuration_SecondQuarterMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 0, "0.00", "JPYPerShares", "CurrentYearDuration_ThirdQuarterMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 78, "78.00", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 78, "78.00", "JPYPerShares", "CurrentYearDuration_AnnualMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 0, "0.00", "JPYPerShares", "CurrentYearDuration_FirstQuarterMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 0, "0.00", "JPYPerShares", "CurrentYearDuration_SecondQuarterMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 0, "0.00", "JPYPerShares", "CurrentYearDuration_ThirdQuarterMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 88, "88.00", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_Curr