, ["AmountChangeProfitAttributableToOwnersOfParent", "AmountChangeProfitAttributableToOwnersOfParent", "tse-ed-t", "予想", 45000000, "45", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInNetSales", "ChangeInNetSales", "tse-ed-t", "予想", -0.113, "11.3", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOperatingIncome", "ChangeInOperatingIncome", "tse-ed-t", "予想", 0.12, "12.0", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOrdinaryIncome", "ChangeInOrdinaryIncome", "tse-ed-t", "予想", 0.172, "17.2", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInProfitAttributableToOwnersOfParent", "ChangeInProfitAttributableToOwnersOfParent", "tse-ed-t", "予想", 0.132, "13.2", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "前期", 5963000000, "5,963", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "前期", 461000000, "461", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "前期", 497000000, "497", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["ProfitAttributableToOwnersOfParent", "ProfitAttributableToOwnersOfParent", "tse-ed-t", "前期", 178000000, "178", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "前期", 31.85, "31.85", "JPYPerShares", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForForecastCorrection", "ReasonForForecastCorrection", "tse-ed-t", "当期", null, "当初第４四半期に予定していた複数の販売用不動産物件について、売却時期を翌連結会計年度へ変更いたしました。これは、出口価格の引き下げによる早期売却を回避し、当初計画した利益水準を確保するための「経営資源の最適化」および「資産価値の最大化」を優先した戦略的選択によるものです。なお、当該物件については売却完了までの期間、継続して賃料収入を計上しており、資産の収益性は維持されております。一方で、主力のオンライン営業組織による成長は堅調に進んでいることから、営業利益、経常利益及び親会社株主に帰属する当期純利益につきましては、期初の想定を上回る見込みです。", null, "CurrentYearDuration"], ["PreviousReportingDateOfDividendForecast", "PreviousReportingDateOfDividendForecast", "tse-ed-t", "当期末", null, "（2025年５月14日発表）", null, "CurrentYearInstant_AnnualMember_NonConsolidatedMember_PreviousMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 60, "60.00", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 60, "60.00", "JPYPerShares", "CurrentYearDuration_AnnualMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 65, "65.00", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 65, "65.00", "JPYPerShares", "CurrentYearDuration_AnnualMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "当期", 0, "0.00", "JPYPerShares", "CurrentYearDuration_SecondQuarterMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 0, "0.00", "JPYPerShares", "PriorYearDuration_SecondQuarterMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 42, "42.00", "JPYPerShares", "PriorYearDuration_YearEndMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 42, "42.00", "JPYPerShares", "PriorYearDuration_AnnualMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForDividendForecastCorrection", "ReasonForDividendForecastCorrection", "tse-ed-t", "当期", null, "当社では、中長期的な企業価値向上と株主への適切な利益還元の双方を図ることを重要な経営課題として認識しております。企業価値向上に向けた成長投資については、事業成長を最優先としつつ、資本効率性を勘案した資本政策も念頭に置きながら実施する一方で、利益配分につきましては弾力的に実施することを基本方針としております。また、2024年３月５日に公表した中期経営計画の中でも言及しておりますとおり、2025年３月期から2027年３月期までの３期間は配当性向100％を目指しております。以上の方針のもと、2026年３月期通期業績予想の修正に伴い、2025年５月14日に公表した１株当たり60円から５円増配し65円に修正することといたしました。（注）上記の業績予想は当社が現時点で入手可能な情報から得た判断に基づく将来の予想であり、当社としてその実現を約束するものではありません。実際の業績は、今後の様々な要因により、予想数値とは異なる場合があります。なお、今期から生損保手数料売上に係る会計方針を変更し、前期実績についても遡及して適用しているため、前期公表の数値とは異なっています。", null, "CurrentYearDuration"], ["FiscalYearEnd", "FiscalYearEnd", "tse-ed-t", "当期末", null, "2026-03-31", null, "CurrentYearInstant"]]}}