nNetSales", "tse-ed-t", "予想", -0.098, "9.8", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOperatingIncome", "ChangeInOperatingIncome", "tse-ed-t", "予想", -0.388, "38.8", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOrdinaryIncome", "ChangeInOrdinaryIncome", "tse-ed-t", "予想", -0.359, "35.9", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInProfitAttributableToOwnersOfParent", "ChangeInProfitAttributableToOwnersOfParent", "tse-ed-t", "予想", -0.351, "35.1", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "前期", 18077000000, "18,077", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "前期", 819000000, "819", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "前期", 807000000, "807", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["ProfitAttributableToOwnersOfParent", "ProfitAttributableToOwnersOfParent", "tse-ed-t", "前期", 494000000, "494", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "前期", 11.38, "11.38", "JPYPerShares", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForForecastCorrection", "ReasonForForecastCorrection", "tse-ed-t", "当期", null, "企業のデジタル投資や昨今のAI活用加速に伴い、ITエンジニア需要は依然として高止まりを見せております。こうした良好な市場環境のもと、当社グループにおきましても企業からの案件数は底堅く推移し、登録エンジニア数につきましても期初想定の68,000人に対し71,258人と順調に拡大し、人材基盤の拡充が進んでおります。しかしながら、2026年８月期の売上高につきましては、主にMidworks事業において、営業機能の専門分化や案件管理の精緻化といった営業体制の強化が計画より遅滞したことに加え、企業への提案力および案件とエンジニアのマッチング精度に課題を残したことにより、フリーランスエンジニアへのマッチングが停滞いたしました。これにより、リード獲得から商談化・マッチングに至るスピードと質を十分に引き上げることができず、拡大する市場需要を受注へと転換しきれなかったことから、稼働エンジニア数が期初想定の25,134人に対し22,684人と想定を下回る結果となり、前回発表の予想から2,377百万円下回る見通しとなりました。また、営業利益につきましては、Midworks事業において広告宣伝費や採用広告費の抑制を図ったことで同事業における大きな乖離を防いだものの、マーケティングプラットフォームサービスにおいて、高利益商材の売上額が減少したことに加え、コンサル・アドバイザリーセグメントにおける人材投資が先行したこと、および将来的なAIコンサルティング関連事業の拡大に向けた先行投資により、前回発表の予想から514百万円の差異が生じております。こうした状況を踏まえ売上高、営業利益、経常利益及び親会社株主に帰属する当期純利益について前回発表の予想を下回る見通しとなりました。当社グループでは、今回顕在化した「営業・マッチング機能」および「生産性」におけるボトルネックの解消こそが、今後の成長加速に向けた最優先課題であり収益性を飛躍的に高める重要な機会であると認識しております。今後は、AI活用によるニーズ分析や提案資料生成を通じた提案力の強化、スキルデータの整備とAIレコメンドを組み合わせた最適マッチングの実現、さらには営業機能の専門分化と案件管理の精緻化に迅速に注力してまいります。これら営業・マッチング機能の抜本的な強化を通じて機会損失を防ぎ、事業成長速度を一段と加速させるとともに、中長期的な成長基盤の構築に取り組んでまいります。なお、2027年８月期の業績につきましては、上述の施策に加え、2026年９月17日に発表いたしました「企業のAI実装支援強化に向けた子会社２社設立のお知らせ」にもある通り、中長期の成長を見据え、AIコンサルティング会社の設立をはじめとした新規事業分野へ投資を行うことで、中長期的な利益体質の強化に努めてまいります。また、上流事業で創出した案件を、当社の主力事業であるエンジニアプラットフォームサービスへ展開することによる相乗効果も見込んでおります。あわせて、同サービス単体におきましても、人員補強や組織体制の強化を通じて、売上の拡大および継続的な収益性の向上に取り組んでまいります。（注）上記の予想は、発表日現在において入手可能な情報に基づき作成したものであり、実際の業績は、 様々な要因によって異なる結果となる可能性があります。以 上", null, "CurrentYearDuration"], ["FiscalYearEnd", "FiscalYearEnd", "tse-ed-t", "当期末", null, "2026-08-31", null, "CurrentYearInstant"]]}}