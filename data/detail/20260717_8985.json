（負ののれん）の活用額は2,759百万円減少しておりますが、差額の414百万円については、今回予想の予想期末発行済投資口数が前回予想から80,700口減少となったことから、投資口の希薄化対応額が減少したものです。", null, "CurrentAccumulatedQ2Duration"], ["DistributionsPerUnitExcludingDistributionsInExcessOfProfitREIT", "DistributionsPerUnitExcludingDistributionsInExcessOfProfitREIT", "tse-re-t", "予想", 5177, "5,177", "JPYPerUnits", "CurrentYearDuration_NonConsolidatedMember_PreviousMember_ForecastMember"], ["DistributionsPerUnitExcludingDistributionsInExcessOfProfitREIT", "DistributionsPerUnitExcludingDistributionsInExcessOfProfitREIT", "tse-re-t", "予想", 5580, "5,580", "JPYPerUnits", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["DistributionsPerUnitExcludingDistributionsInExcessOfProfitREIT", "DistributionsPerUnitExcludingDistributionsInExcessOfProfitREIT", "tse-re-t", "前期", 5061, "5,061", "JPYPerUnits", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["FiscalYearEnd", "FiscalYearEnd", "tse-re-t", "当期末", null, "2026-12-31", null, "CurrentYearInstant"]]}}