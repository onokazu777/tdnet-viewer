4,198", "JPY", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "予想", 15673000000, "15,673", "JPY", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["NetIncome", "NetIncome", "tse-ed-t", "予想", 10405000000, "10,405", "JPY", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "予想", 103.63, "103.63", "JPYPerShares", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["AmountChangeNetSales", "AmountChangeNetSales", "tse-ed-t", "予想", 20798000000, "20,798", "JPY", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["AmountChangeOrdinaryIncome", "AmountChangeOrdinaryIncome", "tse-ed-t", "予想", -6227000000, "6,227", "JPY", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["AmountChangeNetIncome", "AmountChangeNetIncome", "tse-ed-t", "予想", -3595000000, "3,595", "JPY", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInNetSales", "ChangeInNetSales", "tse-ed-t", "予想", 0.034, "3.4", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOrdinaryIncome", "ChangeInOrdinaryIncome", "tse-ed-t", "予想", -0.284, "28.4", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInNetIncome", "ChangeInNetIncome", "tse-ed-t", "予想", -0.257, "25.7", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "前期", 543108000000, "543,108", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "前期", 17417000000, "17,417", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["NetIncome", "NetIncome", "tse-ed-t", "前期", 11504000000, "11,504", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "前期", 114.58, "114.58", "JPYPerShares", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForForecastCorrection", "ReasonForForecastCorrection", "tse-ed-t", "当期", null, "通期連結業績予想につきましては、当中間連結会計期間の実績および下期以降の事業環境・費用構造の見通しを踏まえ、修正いたします。   売上高につきましては、資本効率を重視した大型店舗の新規出店計画を期初想定の10店舗から13店舗へ上方修正したこと、ならびに通期の卸売販売台数の増加見通しを反映し、前回発表予想の6,290億円から6,550億円へ上方修正いたします。   利益面につきましては、営業利益を185億円、経常利益を164億円、親会社株主に帰属する当期純利益を105億円へそれぞれ修正いたします。これは、上期において営業利益が期初計画に対し31億円下振れた実績を通期予想に反映したことに加え、下期における成長投資コストの増加を織り込んだことによるものです。   下期におきましては、第1四半期に実施した在庫処分に伴う在庫健全化、および新規大型店舗の稼働に伴う小売販売台数と台あたり粗利の向上により、売上総利益は期初想定を上回って拡大する見通しであります。また、上期に先行採用した人材の戦力化が進むことで、営業現場の生産性改善も見込んでおります。   しかしながら、下期に集中する大型店舗10店舗の新規開設に伴う準備費用や設備投資関連費、人員体制の拡充に伴う人件費、ならびに買取強化に向けた広告宣伝費の投下など、中長期的な企業価値向上を見据えた積極的な成長投資を継続するため、販売費及び一般管理費が当初計画を上回って推移する見込みであります。   この結果、売上総利益の増加分のみでは高水準な成長投資に伴う販管費の増加分を完全に吸収することが困難となり、下期の営業利益見通しを97億円へ見直すことといたしました。   これにより、通期の連結営業利益は185億円、連結経常利益は164億円、親会社株主に帰属する当期純利益は105億円となる見通しであります。なお、個別業績予想につきましても、連結と同様の要因および前提に基づき修正しております。", null, "CurrentYearDuration"], ["FiscalYearEnd", "FiscalYearEnd", "tse-ed-t", "当期末", null, "2027-02-28", null, "CurrentYearInstant"]]}}