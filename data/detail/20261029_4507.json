eProfitAttributableToOwnersOfParent", "tse-ed-t", "予想", 2500000000, "2,500", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInNetSales", "ChangeInNetSales", "tse-ed-t", "予想", 0.029, "2.9", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOperatingIncome", "ChangeInOperatingIncome", "tse-ed-t", "予想", 0.045, "4.5", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInIncomeBeforeIncomeTaxesUS", "ChangeInIncomeBeforeIncomeTaxesUS", "tse-ed-t", "予想", 0.002, "0.2", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInProfitAttributableToOwnersOfParent", "ChangeInProfitAttributableToOwnersOfParent", "tse-ed-t", "予想", 0.012, "1.2", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "前期", 499677000000, "499,677", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "前期", 170306000000, "170,306", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["IncomeBeforeIncomeTaxesUS", "IncomeBeforeIncomeTaxesUS", "tse-ed-t", "前期", 242497000000, "242,497", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["ProfitAttributableToOwnersOfParent", "ProfitAttributableToOwnersOfParent", "tse-ed-t", "前期", 209244000000, "209,244", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "前期", 245.91, "245.91", "JPYPerShares", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForForecastCorrection", "ReasonForForecastCorrection", "tse-ed-t", "当期", null, "当中間連結会計期間においては、売上収益およびすべての利益項目で、業績予想を上回りました。主な要因は、2025年度に実施した成長投資1, 2, 3, 4の成果が着実に業績として表れたことによるものです。　海外事業では、筋萎縮性側索硬化症（ALS）治療薬RADICAVAに関する事業承継が円滑に進み、希少疾患の事業基盤の構築が着実に進展しました。また、従来からの強みである感染症領域では、欧米におけるセフィデロコルの販売が順調に推移しました。国内事業では、不眠症治療薬クービビック、鳥居薬品関連製品、ALS等治療薬ラジカットなどのQOL疾患領域の製品が伸長しました。COVID-19の流行が想定を下回る中でも、これらの製品の伸長により、感染症の流行に左右されにくい安定的な収益基盤の構築が進みました。さらに、当社の収益基盤であるHIV事業についても、ヴィーブ社において、主力製品の経口2剤配合剤であるDovatoに加え、今後の中長期的な収益源となる長時間作用型注射製剤であるCabenuvaとApretudeの販売が、引き続き好調に推移し、ロイヤリティー収入および持分法投資利益が増加しました。こうした成長投資の成果と既存事業の堅調な推移が好調な業績を牽引しました。　これらの主要事業の好調な進捗を踏まえ、通期業績予想を上方修正します。海外事業では、RADICAVA事業の順調な立ち上がりに加え、IntraBio社の買収4により希少疾患を新たな成長領域と位置付け、米国に加え、欧州においても新たな事業基盤の構築を目指します。買収取引完了後には、ニーマン・ピック病C型（NPC）に伴う神経学的症状および毛細血管拡張性運動失調症（A-T）の治療薬AQNEURSAの販売開始を予定しており、NPCおよびA-T患者さまへの貢献を拡大します。国内事業では、市場浸透が加速しているクービビックのさらなる成長を見込んでいます。HIV事業では、ヴィーブ社の好調な業績を踏まえ親会社であるGSK社が、ヴィーブ社の業績予想を引き上げたことに伴い、当社の受領するロイヤリティー収入および持分法投資利益が増加する見通しです。　　一方、費用面では、IntraBio社の買収に伴う無形資産の償却費や、米国事業の成長に向けた積極的な投資の継続により、販売費・一般管理費が増加する見込みですが、適切なコスト管理を行っていきます。また、研究開発費については、開発パイプラインの厳格な優先順位付けにより選択と集中を進める計画です。以上を踏まえ、将来の成長に向けた投資を継続しつつ、通期の売上収益とすべての利益項目の業績予想を上方修正します。", null, "CurrentYearDuration"], ["FiscalYearEnd", "FiscalYearEnd", "tse-ed-t", "当期末", null, "2027-03-31", null, "CurrentYearInstant"]]}}