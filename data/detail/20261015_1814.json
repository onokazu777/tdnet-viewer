r"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "前期", 6627000000, "6,627", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["NetIncome", "NetIncome", "tse-ed-t", "前期", 1916000000, "1,916", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "前期", 184.37, "184.37", "JPYPerShares", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForForecastCorrection", "ReasonForForecastCorrection", "tse-ed-t", "当期", null, "（１）2027年３月期第２四半期累計期間（連結業績予想）売上高につきましては、工事進捗が当初想定を上回ったこと等により、前回予想を上回る見込みです。利益面につきましては、工事採算の良化に加え、設計変更や物価上昇等への対応が進展したことにより、営業利益、経常利益及び親会社株主に帰属する中間純利益は前回予想を上回る見込みです。（個別業績予想）連結業績予想と同様の理由により修正いたします。（２）2027年３月期通期（連結業績予想）売上高につきましては、概ね前回予想どおりに推移する見込みです。利益面につきましては、第２四半期累計期間と同様の理由により前回予想を上回る見込みです。（個別業績予想）連結業績予想と同様の理由により修正いたします。", null, "CurrentYearDuration"], ["PreviousReportingDateOfDividendForecast", "PreviousReportingDateOfDividendForecast", "tse-ed-t", "当期末", null, "（2026年5月12日発表）", null, "CurrentYearInstant_AnnualMember_NonConsolidatedMember_PreviousMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 93, "93.00", "JPYPerShares", "CurrentYearDuration_SecondQuarterMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 93, "93.00", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 186, "186.00", "JPYPerShares", "CurrentYearDuration_AnnualMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 117, "117.00", "JPYPerShares", "CurrentYearDuration_SecondQuarterMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 117, "117.00", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 234, "234.00", "JPYPerShares", "CurrentYearDuration_AnnualMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 87, "87.00", "JPYPerShares", "PriorYearDuration_SecondQuarterMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 96, "96.00", "JPYPerShares", "PriorYearDuration_YearEndMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 183, "183.00", "JPYPerShares", "PriorYearDuration_AnnualMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForDividendForecastCorrection", "ReasonForDividendForecastCorrection", "tse-ed-t", "当期", null, "当社は、更なる企業価値の向上に向けて積極的な成長投資と安定的な株主還元を行うという考えのもと、2025年３月期より総還元性向50％以上かつＤＯＥ4.0％以上とすることを基本方針としております。この方針のもと、2027年３月期の中間及び期末配当予想をそれぞれ１株当たり93円から24円増配の117円に修正することといたしました。なお、当期の年間配当金は、１株当たり234円、配当性向は50.09％となる見込みです。（注）上記の予想は、本資料の発表日現在において入手可能な情報に基づき作成したものであり、実際の業績は今後の様々な要因によって予想と異なる可能性があります。", null, "CurrentYearDuration"], ["FiscalYearEnd", "FiscalYearEnd", "tse-ed-t", "当期末", null, "2027-03-31", null, "CurrentYearInstant"]]}}