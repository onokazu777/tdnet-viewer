に組み替えて表示しております。そのため、これらの対前年同四半期増減率は記載しておりません。", null, "CurrentAccumulatedQ1Duration_ConsolidatedMember_ResultMember"], ["総資産", "TotalAssets", "tse-ed-t", "当期末", 8151335000000, "8,151,335", "JPY", "CurrentAccumulatedQ1Instant_ConsolidatedMember_ResultMember"], ["純資産合計", "NetAssets", "tse-ed-t", "当期末", 3239575000000, "3,239,575", "JPY", "CurrentAccumulatedQ1Instant_ConsolidatedMember_ResultMember"], ["株主資本合計", "ShareholdersEquity", "tse-ed-t", "当期末", 3171235000000, "3,171,235", "JPY", "CurrentAccumulatedQ1Instant_ConsolidatedMember_ResultMember"], ["自己資本比率（%）", "EquityToAssetRatio", "tse-ed-t", "当期末", 0.389, "38.9", "Pure", "CurrentAccumulatedQ1Instant_ConsolidatedMember_ResultMember"], ["総資産", "TotalAssets", "tse-ed-t", "前期末", 8269711000000, "8,269,711", "JPY", "PriorYearInstant_ConsolidatedMember_ResultMember"], ["純資産合計", "NetAssets", "tse-ed-t", "前期末", 3228400000000, "3,228,400", "JPY", "PriorYearInstant_ConsolidatedMember_ResultMember"], ["株主資本合計", "ShareholdersEquity", "tse-ed-t", "前期末", 3088566000000, "3,088,566", "JPY", "PriorYearInstant_ConsolidatedMember_ResultMember"], ["自己資本比率（%）", "EquityToAssetRatio", "tse-ed-t", "前期末", 0.373, "37.3", "Pure", "PriorYearInstant_ConsolidatedMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 12, "12.00", "JPYPerShares", "PriorYearDuration_SecondQuarterMember_NonConsolidatedMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 13, "13.00", "JPYPerShares", "PriorYearDuration_YearEndMember_NonConsolidatedMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 25, "25.00", "JPYPerShares", "PriorYearDuration_AnnualMember_NonConsolidatedMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 14, "14.00", "JPYPerShares", "CurrentYearDuration_SecondQuarterMember_NonConsolidatedMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 15, "15.00", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_ForecastMember"], [