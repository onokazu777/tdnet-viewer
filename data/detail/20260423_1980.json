000000, "2,100", "JPY", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["AmountChangeNetIncome", "AmountChangeNetIncome", "tse-ed-t", "予想", 2300000000, "2,300", "JPY", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInNetSales", "ChangeInNetSales", "tse-ed-t", "予想", -0.026, "2.6", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOperatingIncome", "ChangeInOperatingIncome", "tse-ed-t", "予想", 0.044, "4.4", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOrdinaryIncome", "ChangeInOrdinaryIncome", "tse-ed-t", "予想", 0.065, "6.5", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInNetIncome", "ChangeInNetIncome", "tse-ed-t", "予想", 0.1, "10.0", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "前期", 248681000000, "248,681", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "前期", 22998000000, "22,998", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "前期", 23272000000, "23,272", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["NetIncome", "NetIncome", "tse-ed-t", "前期", 17508000000, "17,508", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "前期", 136.11, "136.11", "JPYPerShares", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["NoteToFinancialForecast", "NoteToFinancialForecast", "tse-ed-t", "当期", null, "当社は、2026年１月１日付で普通株式１株につき３株の割合で株式分割を行っております。前連結会計年度の期首に当該株式分割が行われたと仮定し、「１株当たり当期純利益」を算定しております。", null, "CurrentYearDuration"], ["ReasonForForecastCorrection", "ReasonForForecastCorrection", "tse-ed-t", "当期", null, "連結業績予想の修正理由につきましては、次のとおりであります。完成工事高は、手持ち工事の進捗が直近公表時の想定を下回る見込みにより、直近の公表の260,000百万円から5,000百万円減の255,000百万円となる見通しです。営業利益は、工事のさらなる利益改善などにより、直近の公表の32,000百万円から2,000百万円増の34,000百万円となる見通しです。経常利益及び親会社株主に帰属する当期純利益につきましては、営業利益の上振れに加え、為替差益の計上、政策保有株式の売却による投資有価証券売却益の計上、賃上げ促進税制の適用による税額控除などにより、直近の公表を上回る見通しです。なお、受注高は、好調に推移している国内の受注状況を受け、直近の公表の320,000百万円から30,000百万円増の350,000百万円となる見込みです。個別業績予想の修正理由につきましては、連結業績予想の修正と同様の理由により修正しております。", null, "CurrentYearDuration"], ["PreviousReportingDateOfDividendForecast", "PreviousReportingDateOfDividendForecast", "tse-ed-t", "当期末", null, "（2026年２月６日発表）", null, "CurrentYearInstant_AnnualMember_NonConsolidatedMember_PreviousMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 45, "45.00", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 54, "54.00", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "当期", 82, "82.00", "JPYPerShares", "CurrentYearDuration_SecondQuarterMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 52, "52.00", "JPYPerShares", "PriorYearDuration_SecondQuarterMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 111, "111.00", "JPYPerShares", "PriorYearDuration_YearEndMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 163, "163.00", "JPYPerShares", "PriorYearDuration_AnnualMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["NoteToDividends", "NoteToDividends", "tse-ed-t", "当期", null, "当社は、2026年１月１日付で普通株式１株につき３株の割合で株式分割を行っております。（1）今回修正予想は、株式分割後の配当金の額を記載しております。年間の１株当たり配当予想については、株式分割の実施により単純計算ができないため表示しておりません。なお、参考として分割前換算の配当金の額を（　）内に記載しております。（2）当期実績（第２四半期末）及び前期実績は、株式分割前の配当額を記載しております。", null, "CurrentYearDuration"], ["ReasonForDividendForecastCorrection", "ReasonForDividendForecastCorrection", "tse-ed-t", "当期", null, "当社は、健全な財務体質の構築に努めると共に、経営上の最重要施策である株主への利益還元を進めており、「配当性向40％以上かつ純資産配当率（DOE）4.8％を下限とすること」を配当方針としております。この方針に基づき、上記業績予想の通り、2026年３月期の業績見通しが直近の配当予想公表時における予想値を上回ること等を勘案し、期末配当金を前回予想の１株当たり45円から9円引き上げ54円（分割前162円）に修正いたします。この結果、株式分割前換算での年間配当金は1株当たり217円から244円となります。なお、期末配当金は、2026年６月開催予定の第97回定時株主総会の決議を経て正式に決定する予定です。（注）上記の予想の修正につきましては、発表日現在において入手可能な情報に基づいて作成したものであり、実際の業績は、業績予想数値と異なる場合があります。", null, "CurrentYearDuration"], ["FiscalYearEnd", "FiscalYearEnd", "tse-ed-t", "当期末", null, "2026-03-31", null, "CurrentYearInstant"]]}}