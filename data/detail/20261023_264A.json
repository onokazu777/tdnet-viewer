", "JPY", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["NetIncome", "NetIncome", "tse-ed-t", "予想", 101000000, "101", "JPY", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "予想", 8.29, "8.29", "JPYPerShares", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["AmountChangeNetSales", "AmountChangeNetSales", "tse-ed-t", "予想", -469000000, "469", "JPY", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["AmountChangeOperatingIncome", "AmountChangeOperatingIncome", "tse-ed-t", "予想", -118000000, "118", "JPY", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["AmountChangeOrdinaryIncome", "AmountChangeOrdinaryIncome", "tse-ed-t", "予想", -117000000, "117", "JPY", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["AmountChangeNetIncome", "AmountChangeNetIncome", "tse-ed-t", "予想", -121000000, "121", "JPY", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInNetSales", "ChangeInNetSales", "tse-ed-t", "予想", -0.12, "12.0", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOperatingIncome", "ChangeInOperatingIncome", "tse-ed-t", "予想", -0.446, "44.6", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOrdinaryIncome", "ChangeInOrdinaryIncome", "tse-ed-t", "予想", -0.448, "44.8", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInNetIncome", "ChangeInNetIncome", "tse-ed-t", "予想", -0.544, "54.4", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "前期", 3360000000, "3,360", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "前期", 290000000, "290", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "前期", 258000000, "258", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["NetIncome", "NetIncome", "tse-ed-t", "前期", 175000000, "175", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "前期", 14.31, "14.31", "JPYPerShares", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForForecastCorrection", "ReasonForForecastCorrection", "tse-ed-t", "当期", null, "(1)売上高　2026 年9月期につきましては、事業の収益基盤拡大および持続的成長に向けた重点事業戦略の1つとして、大企業(エンタープライズ企業)を中心とした動画学習サービス「Schoofor Business」および学びを軸とした組織変革コンサルティングサービス「Enterprise Drive」(以下、「同サービス」とする。)の新規大規模案件の獲得、ならびに既存大企業顧客における部門横断的な全社利用拡大(アップセル)に注力してまいりました。　しかしながら、顧客企業における教育研修予算に対する費用対効果の精査が一段と厳格化したことを受け、以下の要因により当期の売上高は期初計画を下回る見込みとなりました。1 大企業向け新規大型案件の獲得遅延および契約規模のスモールスタート化　大企業を対象とした新規商談につきましては、顧客企業における事前の効果検証(トライアル導入)の実施や、費用対効果の精査に伴う決裁プロセスの多層化・慎重化により、商談開始から最終契約に至るリードタイムが想定を上回って長期化いたしました。　また、初期導入時において全社一括導入ではなく、特定部門での限定導入やスモールスタートを選択する顧客が増加したことにより、期初計画の前提としていた大企業1社あたりの契約 ID 規模が想定を下回る結果となりました。2 既存大企業顧客における同サービス全社利用拡大の意思決定長期化と交渉難度の上昇　同サービスを導入済みの大企業顧客における他部門への横展開や全社ライセンスへのアップセルにつきまして、効果検証の長期化や予算配分の精査により、顧客社内での検討プロセスが長期化いたしました。　その結果、当期における追加契約の締結・課金開始に至らず、計画していたストック売上高の積み上げが未達となりました。　なお、第3四半期までの事業進捗に鑑み、第4四半期における短期的なリカバリー策として、「AI 関連ゼミ」の個別販売による単発売上の獲得や、AI を活用した営業体制による商談クロージングの徹底によるストック売上の拡大等に努めてまいりました。これらの施策により一定の売上寄与は見られたものの、期初計画との乖離を補うには至りませんでした。(ご参考_2026 年9月期 主要 KPI の計画および実績(※1))　・法人全体 ARR： 計画 3,996百万円、実績 3,147百万円（達成率78.8%）　・ARPA(※2) ：計画 137千円/月、実績 123千円/月（達成率 89.8%）　・契約社数(※2) ：計画 2,541社、実績 2,216社（達成率 87.2%）　・大企業 MRR 成長指数(※2)： 計画 6.3倍、実績 5.0倍 （達成率80.5%）　(※1)本資料発表日現在における速報値です。　(※2)2026 年9月期第2四半期より、ARPA、契約社数および大企業 MRR 成長指数の定義を変更しております。上記の計画は、変更後の定義に基づき期初計画を算定し直した数値であり、実績も変更後の定義に基づき算出しております。(2)営業利益、経常利益および当期純利益　大企業攻略に向けた専門営業体制の強化や、顧客ごとの個別最適化ニーズに対応するための機能拡充等の戦略的投資を計画通り進めた一方、上記のとおり売上高の立ち上がりが遅れたことで固定費負担を吸収しきれず、各利益段階において前回発表予想を下回る見込みとなりました。(3)今後の対応策　当社は、顧客の投資選別姿勢や多様化するニーズに即応すべく、既存顧客への活用支援強化による契約継続率の維持に努めるとともに、顧客の組織課題に即した高付加価値な機能・プログラムの拡充を進めてまいります。また、商談の長期化に対応した営業プロセスの効率化およびコスト構造の適正化を徹底し、早期の業績回復と持続的な成長基盤の構築に邁進してまいります。　2027年9月期の業績予想及び事業進捗並びに今後の対応策等の詳細につきましては、2026年 11 月 16 日公表予定の「2026年9月期 決算短信〔日本基準〕(連結)」及び決算説明資料等にてお知らせいたします。※2026年9月期連結業績予想および 2026年9月期個別業績予想は、本資料発表日現在において入手可能な情報に基づき作成したものであり、実際の業績は今後の様々な要因により予想数値と異なる可能性があります。", null, "CurrentYearDuration"], ["FiscalYearEnd", "FiscalYearEnd", "tse-ed-t", "当期末", null, "2026-09-30", null, "CurrentYearInstant"]]}}