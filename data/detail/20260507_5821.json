となりました。当社としては、当該事業の中長期的な成長性および将来的な回収可能性を見込んでいるものの、主としてHEWTECH PHILIPPINES ELECTRONICS CORP.における業績実績を背景に、過去数年間の業績動向および将来見通しの不確実性を重視する監査上の観点から、「固定資産の減損に関する基準」に基づき、減損損失2,471百万円を特別損失として計上することといたしました。", null, "CurrentYearInstant"], ["売上高", "NetSales", "tse-ed-t", "予想", 36500000000, "36,500", "JPY", "CurrentYearDuration_ConsolidatedMember_PreviousMember_ForecastMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "予想", 4000000000, "4,000", "JPY", "CurrentYearDuration_ConsolidatedMember_PreviousMember_ForecastMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "予想", 4000000000, "4,000", "JPY", "CurrentYearDuration_ConsolidatedMember_PreviousMember_ForecastMember"], ["ProfitAttributableToOwnersOfParent", "ProfitAttributableToOwnersOfParent", "tse-ed-t", "予想", 3300000000, "3,300", "JPY", "CurrentYearDuration_ConsolidatedMember_PreviousMember_ForecastMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "予想", 213.08, "213.08", "JPYPerShares", "CurrentYearDuration_ConsolidatedMember_PreviousMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "予想", 38420000000, "38,420", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "予想", 4410000000, "4,410", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "予想", 4630000000, "4,630", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ProfitAttributableToOwnersOfParent", "ProfitAttributableToOwnersOfParent", "tse-ed-t", "予想", 1640000000, "1,640", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "予想", 105.69, "105.69", "JPYPerShares", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["AmountChangeNetSales", "AmountChangeNetSales", "tse-ed-t", "予想", 1920000000, "1,920", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["AmountChangeO