mber"], ["ChangeInNetSales", "ChangeInNetSales", "tse-ed-t", "予想", 0, "0.0", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOperatingIncome", "ChangeInOperatingIncome", "tse-ed-t", "予想", 0, "0.0", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOrdinaryIncome", "ChangeInOrdinaryIncome", "tse-ed-t", "予想", 0, "0.0", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInProfitAttributableToOwnersOfParent", "ChangeInProfitAttributableToOwnersOfParent", "tse-ed-t", "予想", 0.18, "18.0", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "前期", 1691808000000, "1,691,808", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "前期", 16166000000, "16,166", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "前期", 20002000000, "20,002", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["ProfitAttributableToOwnersOfParent", "ProfitAttributableToOwnersOfParent", "tse-ed-t", "前期", 14778000000, "14,778", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "前期", 21.95, "21.95", "JPYPerShares", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForForecastCorrection", "ReasonForForecastCorrection", "tse-ed-t", "当期", null, "当中間連結会計期間においては、2026年10月27日付開示「2027 年３月期第２四半期（中間期）連結業績予想の修正に関するお知らせ」に記載のとおり、当社グループが推進する「くらしまるごと」戦略による構造改革の成果が定着してきたことにより、業績は堅調に推移しました。さらに、資産効率の最大化に向けた資産売却プロジェクトの各種施策について、一部の非事業用資産の売却が先行して進む等、順調に進捗したため、親会社株主に帰属する中間純利益が大きく伸長いたしました。その結果、親会社株主に帰属する当期純利益が当初予想を上回ることから、2027年３月期の通期連結業績予想につきまして、前回予想を上方修正いたします。なお、売上高・営業利益・経常利益は、今後の市場動向を慎重に見極める必要があることから、当初予想を据え置いております。当社は、ノンコア事業資産を中心とした資産売却プロジェクトを推進しておりますが、今回の2027年３月期通期連結業績予想の修正には、第３四半期以降に見込まれる影響を含めておりません。資産売却プロジェクトを想定どおりに進捗させた場合、親会社株主に帰属する当期純利益は、現時点では上振れとなる見込みであり、合理的な算定が可能となった時点で、速やかに公表いたします。【期末配当の方針について】当社は、利益配分に関する基本方針において、将来における持続的な企業価値向上に向け、資金効率の向上を図りつつも、経営基盤の強化、成長戦略の推進及び業界内におけるシェアの維持・向上のためには内部留保の確保も必要不可欠であると考えております。この基本方針のもと、連結配当性向40％以上を目標とし、財政状況や当期の業績、将来戦略の推進のための内部留保等を勘案して配当金額を決定しております。2027 年３月期の期末配当予想に関しましては、今後の資産売却プロジェクトの状況等を勘案し、決定してまいります。業績の上振れや資産売却プロジェクト等により利益水準が大きく伸長した場合には、中長期的な企業価値向上に資する成長投資に資金を配分することも含め、最適な資金配分を検討してまいります。【業績予想に関する留意事項】本資料に記載されている業績予想及び記述は、発表日現在において入手可能な情報及び合理的であると判断する一定の前提に基づいたものであり、その達成を当社として約束する趣旨のものではありません。実際の業績等は様々な要因により大きく異なる可能性があります。", null, "CurrentYearDuration"], ["FiscalYearEnd", "FiscalYearEnd", "tse-ed-t", "当期末", null, "2027-03-31", null, "CurrentYearInstant"]]}}