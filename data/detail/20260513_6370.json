geProfitAttributableToOwnersOfParentIFRS", "AmountChangeProfitAttributableToOwnersOfParentIFRS", "tse-ed-t", "予想", -20400000000, "20,400", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInNetSales", "ChangeInNetSales", "tse-ed-t", "予想", -0.052, "5.2", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOperatingIncome", "ChangeInOperatingIncome", "tse-ed-t", "予想", 0.08800000000000001, "8.8", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInIncomeBeforeTaxes", "ChangeInIncomeBeforeTaxes", "tse-ed-t", "予想", 0.107, "10.7", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInProfitAttributableToOwnersOfParentIFRS", "ChangeInProfitAttributableToOwnersOfParentIFRS", "tse-ed-t", "予想", -0.562, "56.2", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "前期", 388814000000, "388,814", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "前期", 49918000000, "49,918", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["税引前当期純利益", "IncomeBeforeIncomeTaxes", "tse-ed-t", "前期", 50709000000, "50,709", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["親会社株主に帰属する当期純利益", "ProfitLossAttributableToOwnersOfParent", "tse-ed-t", "前期", 20305000000, "20,305", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり当期純利益", "EarningsPerShare", "tse-ed-t", "前期", 180.66, "180.66", "JPYPerShares", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["NoteToFinancialForecast", "NoteToFinancialForecast", "tse-ed-t", "当期", null, "（注）2026年3月期通期連結業績予想については、下記「１．株式譲渡に伴う非継続事業への分類」に基づいた数値を記載しています。また、前期実績については遡及修正後の数値を記載しています。", null, "CurrentYearDuration"], ["ReasonForForecastCorrection", "ReasonForForecastCorrection", "tse-ed-t", "当期", null, "１．株式譲渡に伴う非継続事業への分類 　本株式譲渡の決定によって、2026年3月期より、IFRS第5号「売却目的で保有する非流動資産及び非継続事業」に従った売却目的保有への資産の分類要件を満たすことから、Pentagon社に関する資産および負債が売却目的保有に分類されることになりました。これにより、売上高、営業利益および税引前利益は非継続事業を除いた継続事業の金額を、親会社の所有者に帰属する当期利益は継続事業と非継続事業を合算した金額を開示します。２．減損損失の計上　本株式譲渡に伴い、売却コスト控除後のPentagon社の資産の公正価値が帳簿価額を下回ることから、同社ののれんを含む固定資産の減損損失として199億円を計上する見込みとなりました。３．2026年3月期通期　連結業績予想の修正（2025年4月1日～2026年3月31日）　売上高は、主にPentagon社の業績が継続事業として認識されなくなることから、前回発表予想を下回る見込みです。また、営業利益および税引前利益は、電子セグメントにおけるサービス事業売上高構成比の上昇による原価率改善効果や販売費及び一般管理費の抑制により前回発表予想を上回る見込みです。親会社の所有者に帰属する当期利益は、Pentagon社に係るのれんを含む固定資産の減損損失の計上により前回発表予想を下回る見込みです。なお、配当予想の変更はありません。（注）本業績予想は、現時点で入手可能な情報に基づき当社が判断したものであり、様々な要因の変化により実際の業績とは異なる場合があります。", null, "CurrentYearDuration"], ["FiscalYearEnd", "FiscalYearEnd", "tse-ed-t", "当期末", null, "2026-03-31", null, "CurrentYearInstant"]]}}