ntMember_ForecastMember"], ["AmountChangeOrdinaryIncome", "AmountChangeOrdinaryIncome", "tse-ed-t", "予想", 35500000000, "35,500", "JPY", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["AmountChangeNetIncome", "AmountChangeNetIncome", "tse-ed-t", "予想", 18000000000, "18,000", "JPY", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInNetSales", "ChangeInNetSales", "tse-ed-t", "予想", 0.034, "3.4", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOperatingIncome", "ChangeInOperatingIncome", "tse-ed-t", "予想", 0.301, "30.1", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOrdinaryIncome", "ChangeInOrdinaryIncome", "tse-ed-t", "予想", 0.275, "27.5", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInNetIncome", "ChangeInNetIncome", "tse-ed-t", "予想", 0.145, "14.5", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "前期", 1589544000000, "1,589,544", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "前期", 84269000000, "84,269", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "前期", 96374000000, "96,374", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["NetIncome", "NetIncome", "tse-ed-t", "前期", 132947000000, "132,947", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "前期", 196.02, "196.02", "JPYPerShares", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForForecastCorrection", "ReasonForForecastCorrection", "tse-ed-t", "当期", null, "＜個別業績予想＞　売上高は、主として国内建築工事の施工が順調に進捗し、完成工事高が増加する見通しとなったことから、前回予想に比べ600億円の増加で見込みます。　営業利益は、国内の建築工事及び土木工事において、追加変更工事の獲得や工事原価の圧縮などにより採算改善が進み、完成工事総利益が増加する見込みとなったことから、前回予想に比べ370億円の増益で見込みます。　なお、完成工事利益率は、前回予想の12.7%（建築13.2%、土木10.0%）に対し、14.5%（建築15.3%、土木11.0%）となる見込みです。　また、特別利益（投資有価証券売却益）を、一部銘柄の株価下落などに伴い前回予想から100億円の減少で見込み、当期純利益については、前回予想に比べ180億円の増益で見込みます。＜連結業績予想＞　主として個別業績予想の修正に伴い、連結業績予想を修正するものです。(注)上記の業績予想は、本資料の発表日現在入手可能な情報に基づいて作成しています。実際の業績は、様々な要因により予想値と異なる可能性があります。", null, "CurrentYearDuration"], ["PreviousReportingDateOfDividendForecast", "PreviousReportingDateOfDividendForecast", "tse-ed-t", "当期末", null, "（2026年７月30日発表）", null, "CurrentYearInstant_AnnualMember_NonConsolidatedMember_PreviousMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 38.5, "38.50", "JPYPerShares", "CurrentYearDuration_SecondQuarterMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 38.5, "38.50", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 77, "77.00", "JPYPerShares", "CurrentYearDuration_AnnualMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 44.5, "44.50", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 89, "89.00", "JPYPerShares", "CurrentYearDuration_AnnualMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "当期", 44.5, "44.50", "JPYPerShares", "CurrentYearDuration_SecondQuarterMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 22, "22.00", "JPYPerShares", "PriorYearDuration_SecondQuarterMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 50, "50.00", "JPYPerShares", "PriorYearDuration_YearEndMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 72, "72.00", "JPYPerShares", "PriorYearDuration_AnnualMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForDividendForecastCorrection", "ReasonForDividendForecastCorrection", "tse-ed-t", "当期", null, "当社は、長期的発展の礎となる財務体質の強化と安定配当を基本方針とし、成長により稼得した利益を連結配当性向40％を目安に還元する方針としております。　この方針のもと、今回の通期業績予想の修正に伴い、中間配当を前回予想の38円50銭から６円増配の44円50銭とすることを本日開催の取締役会で決議するとともに、期末配当予想を前回予想の38円50銭から６円増配の44円50銭に修正いたします。　これにより、年間配当予想は、前回予想の77円から12円増配の89円となります。　なお、親会社株主に帰属する当期純利益に含まれる負ののれん相当額355億円は、キャッシュインを伴わない連結決算手続き上の利益であるため、親会社株主に帰属する当期純利益から除いて配当金を算出しております。", null, "CurrentYearDuration"], ["FiscalYearEnd", "FiscalYearEnd", "tse-ed-t", "当期末", null, "2027-03-31", null, "CurrentYearInstant"]]}}