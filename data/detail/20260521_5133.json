いたしました前回予想を1株当たり５円から40銭増配し、1株当たり５円40銭に修正することといたしました。", null, "CurrentYearDuration"], ["PreviousReportingDate", "PreviousReportingDate", "tse-ed-t", "当期末", null, "2026年5月14日", null, "CurrentYearInstant"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 0, "0.00", "JPYPerShares", "CurrentYearDuration_SecondQuarterMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 5, "5.00", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 5, "5.00", "JPYPerShares", "CurrentYearDuration_AnnualMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 0, "0.00", "JPYPerShares", "CurrentYearDuration_SecondQuarterMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 5.4, "5.40", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 5.4, "5.40", "JPYPerShares", "CurrentYearDuration_AnnualMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "当期", 0, "0.00", "JPYPerShares", "CurrentYearDuration_SecondQuarterMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 0, "0.00", "JPYPerShares", "PriorYearDuration_SecondQuarterMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 5.2, "5.20", "JPYPerShares", "PriorYearDuration_YearEndMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 5.2, "5.20", "JPYPerShares", "PriorYearDuration_AnnualMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["NoteToDividends", "NoteToDividends", "tse-ed-t", "当期", null, "（注）本日開催の取締役会において、2026年３月31日を基準日とする剰余金の配当を行うこ