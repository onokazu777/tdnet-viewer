00000, "266", "JPY", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInNetSales", "ChangeInNetSales", "tse-ed-t", "予想", -0.259, "25.9", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOperatingIncome", "ChangeInOperatingIncome", "tse-ed-t", "予想", -0.779, "77.9", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOrdinaryIncome", "ChangeInOrdinaryIncome", "tse-ed-t", "予想", -0.768, "76.8", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInNetIncome", "ChangeInNetIncome", "tse-ed-t", "予想", -0.7709999999999999, "77.1", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "前期", 1892000000, "1,892", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "前期", 497000000, "497", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "前期", 486000000, "486", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["NetIncome", "NetIncome", "tse-ed-t", "前期", 311000000, "311", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "前期", 148.55, "148.55", "JPYPerShares", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForForecastCorrection", "ReasonForForecastCorrection", "tse-ed-t", "当期", null, "Ｍ＆Ａ仲介市場の環境変化により、成約期間の長期化と成約難易度の上昇が生じており、第４四半期末において当期中の成約を見込んでいた大型案件を含む複数の案件について、検討期間の長期化や不成立が重なり、成約組数は当初計画の56組に対し48組にとどまる見込みです。また、当初計画と比較し、中型・大型案件の成約が少なかったことにより、１組当たり売上高は当初計画の37百万円に対し32百万円と低下する見込みです。　この結果、売上高は、前回発表予想の2,088百万円に対し1,548百万円となる見込みであり、売上高の減少により、営業利益、経常利益、当期純利益は、上表のとおり、前回発表予想を下回る見込みです。また、平均コンサルタント数は当初計画の47.0人に対し45.5人となる見込みです。　なお、受託・打診済の案件については一定程度積み上がっており、当期末時点での進捗案件残数は135件～140件程度となる見込みです。　このような厳しい市場環境を鑑み、前期より始動した「買い手情報リサーチチーム」の増員を進め、鮮度の高い買い手情報の収集を強化してまいります。また、当期より導入した「部門制」においては、部門業績評価制度の導入を軸として、各部門におけるコンサルタントへの指導・営業支援を強化してまいります。さらに、「インサイドセールス部門」を新設し、コンサルタントの営業活動をサポートする体制を構築することで、質の高い売却案件の受託を増加させてまいります。成果の顕在化には一定の時間を要しますが、これらの施策を着実に遂行することにより、成約率の向上と業績の回復を目指してまいります。", null, "CurrentYearDuration"], ["PreviousReportingDateOfDividendForecast", "PreviousReportingDateOfDividendForecast", "tse-ed-t", "当期末", null, "（2025年6月30日発表）", null, "CurrentYearInstant_AnnualMember_NonConsolidatedMember_PreviousMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 0, "0.00", "JPYPerShares", "CurrentYearDuration_SecondQuarterMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 65, "65.00", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 65, "65.00", "JPYPerShares", "CurrentYearDuration_AnnualMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "当期", 0, "0.00", "JPYPerShares", "CurrentYearDuration_SecondQuarterMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 0, "0.00", "JPYPerShares", "PriorYearDuration_SecondQuarterMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 45, "45.00", "JPYPerShares", "PriorYearDuration_YearEndMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 45, "45.00", "JPYPerShares", "PriorYearDuration_AnnualMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForDividendForecastCorrection", "ReasonForDividendForecastCorrection", "tse-ed-t", "当期", null, "当期の配当につきましては、2025年６月30日に開示した配当方針に記載のとおり、配当性向40％程度を目安に実施する予定です。しかしながら、具体的な１株当たり配当金の予想につきましては、現時点では業績が確定していないことから、一旦「未定」とさせていただいた上で、当期業績が確定する2026年6月30日の決算発表時に改めて開示させていただく予定としております。", null, "Curr