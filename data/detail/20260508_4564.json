"0.00", "JPYPerShares", "NextYearDuration_YearEndMember_NonConsolidatedMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 0, "0.00", "JPYPerShares", "NextYearDuration_AnnualMember_NonConsolidatedMember_ForecastMember"], ["TitleForForecasts", "TitleForForecasts", "tse-ed-t", "予想", null, "3. 2027年 3月期の連結業績予想（2026年 4月 1日～2027年 3月31日）", null, "NextYearDuration_ConsolidatedMember_ForecastMember"], ["PreambleToForecasts", "PreambleToForecasts", "tse-ed-t", "予想", null, "今期の連結業績予想については、売上高及び営業利益の予想値の公表が、当社グループ研究開発事業の導出活動ならびに受託検査業務における最大価値創出の阻害要因として作用する可能性が想定されます。また、当社グループの研究開発費用の中には、提携契約の内容によって当社グループ負担または相手方負担のいずれとなるのかが決定される費用も含まれております。　これらの点を考慮して、現時点で当社グループは今回の業績予想について記載をしておりませんが、判明次第お知らせいたします。", null, "NextYearDuration_ConsolidatedMember_ForecastMember"], ["SignificantChangesInTheScopeOfConsolidationDuringThePeriod", "SignificantChangesInTheScopeOfConsolidationDuringThePeriod", "tse-ed-t", "当期", null, "無", null, "CurrentYearDuration_ConsolidatedMember_ResultMember"], ["ChangesBasedOnRevisionsOfAccountingStandard", "ChangesBasedOnRevisionsOfAccountingStandard", "tse-ed-t", "当期", null, "無", null, "CurrentYearDuration_ConsolidatedMember_ResultMember"], ["ChangesOtherThanOnesBasedOnRevisionsOfAccountingStandard", "ChangesOtherThanOnesBasedOnRevisionsOfAccountingStandard", "tse-ed-t", "当期", null, "無", null, "CurrentYearDuration_ConsolidatedMember_ResultMember"], ["ChangesInAccountingEstimates", "ChangesInAccountingEstimates", "tse-ed-t", "当期", null, "無", null, "CurrentYearDuration_ConsolidatedMember_ResultMember"], ["RetrospectiveRestatement", "RetrospectiveRestatement", "tse-ed-t", "当期", null, "無", null, "CurrentYearDuration_ConsolidatedMember_ResultMember"], ["期末発行済株式数", "NumberOfIssuedAndOutstandingSharesAtTheEndOfFiscalYearIncludingTreasuryStock", "tse-ed-t", "当期末", 383643700, "383,643,700", "Shares", "CurrentYearInstant_NonConsolidatedMember_ResultMember"], ["期末発行済株式数", "NumberOfIssuedAndOutstandingSharesAtTheEndOfFiscalYearIncludingTreasuryStock"