別損失として計上する見込みです。２．関係会社株式評価損の計上（個別）当社の連結子会社であるSIS’88 Pte Ltdについて、その株式の実質価額が著しく下落したため、関係会社株式評価損8,200百万円を特別損失として計上する見込みです。なお、当該関係会社株式評価損は、連結決算においては連結消去されるため、2026年３月期の連結業績に与える影響はありません。", null, "CurrentYearInstant"], ["売上高", "NetSales", "tse-ed-t", "予想", 200000000000, "200,000", "JPY", "CurrentYearDuration_ConsolidatedMember_PreviousMember_ForecastMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "予想", 12300000000, "12,300", "JPY", "CurrentYearDuration_ConsolidatedMember_PreviousMember_ForecastMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "予想", 11800000000, "11,800", "JPY", "CurrentYearDuration_ConsolidatedMember_PreviousMember_ForecastMember"], ["ProfitAttributableToOwnersOfParent", "ProfitAttributableToOwnersOfParent", "tse-ed-t", "予想", 7700000000, "7,700", "JPY", "CurrentYearDuration_ConsolidatedMember_PreviousMember_ForecastMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "予想", 246.17, "246.17", "JPYPerShares", "CurrentYearDuration_ConsolidatedMember_PreviousMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "予想", 200000000000, "200,000", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "予想", 12300000000, "12,300", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "予想", 11800000000, "11,800", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ProfitAttributableToOwnersOfParent", "ProfitAttributableToOwnersOfParent", "tse-ed-t", "予想", 3900000000, "3,900", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "予想", 124.59, "124.59", "JPYPerShares", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["AmountChangeNetSales", "AmountChangeNetSales", "tse-ed-t", "予想", 0, "0", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["AmountChangeOperatingIncome",