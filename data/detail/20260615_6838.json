tYearDuration_ConsolidatedMember_PreviousMember_ForecastMember"], ["親会社株主に帰属する当期純利益", "ProfitLossAttributableToOwnersOfParent", "tse-ed-t", "予想", 730000000, "730", "JPY", "CurrentYearDuration_ConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり当期純利益", "EarningsPerShare", "tse-ed-t", "予想", 106.03, "106.03", "JPYPerShares", "CurrentYearDuration_ConsolidatedMember_PreviousMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "予想", 6950000000, "6,950", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "予想", 820000000, "820", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["親会社株主に帰属する当期純利益", "ProfitLossAttributableToOwnersOfParent", "tse-ed-t", "予想", 1835000000, "1,835", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり当期純利益", "EarningsPerShare", "tse-ed-t", "予想", 205.89, "205.89", "JPYPerShares", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["AmountChangeNetSalesIFRS", "AmountChangeNetSalesIFRS", "tse-ed-t", "予想", 330000000, "330", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["AmountChangeRevenueIFRS", "AmountChangeRevenueIFRS", "tse-ed-t", "予想", 260000000, "260", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["AmountChangeProfitAttributableToOwnersOfParentIFRS", "AmountChangeProfitAttributableToOwnersOfParentIFRS", "tse-ed-t", "予想", 1105000000, "1,105", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInNetSales", "ChangeInNetSales", "tse-ed-t", "予想", 0.05, "5.0", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInRevenueIFRS", "ChangeInRevenueIFRS", "tse-ed-t", "予想", 0.464, "46.4", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInProfitAttributableToOwnersOfParentIFRS", "ChangeInProfitAttributableToOwnersOfParentIFRS", "tse-ed-t", "予想", 1.514, "151.4", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "前期", 5587000000, "5,587", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["売上高", "NetSales", "tse-ed-t", "前期", 278000000, "278", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["親会社株主に帰属する当期純利益", "ProfitLossAttributableToOwnersOfParent", "tse-ed-t", "前期", 231000000, "231", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり当期純利益", "EarningsPerShare", "tse-ed-t", "前期", 268, "268.00", "JPYPerShares", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForForecastCorrection", "ReasonForForecastCorrection", "tse-ed-t", "当期", null, "2026年10月期通期の売上高、事業利益、親会社株主に帰属する当期利益が前回2026年２月19日に公表した業績予想を上回る見込みであります。これは、次の２つの要因によるものです。（１）\t電子・通信用機器事業においては、社会インフラでの主力製品の量産フェーズへの移行、モバイルインフラでの大口の受注などの要因に加えて、生産が順調に推移しております。これに伴い、前回の上方修正時の計画をさらに上回り、上表の水準に達する見込みが高くなったものです。この結果、連結ベースの売上高は、前回発表予想の6,620百万円を330百万円上回る6,950百万円、事業利益は同予想の560百万円を260百万円上回る820百万円での着地を見込んでおります。尚、この予想は、現状、部材などの供給面で大きな支障は発生しておりませんが、この状態が継続することを前提にしております。これにより、2025年12月４日に公表した中期経営計画における2028年10月期の営業利益計画761百万円を進行期において上回る見通しとなりました。今後も持続的な業績向上に向け、役職員一同尽力してまいります。（２）\t当社海外現地法人が保有する海外株式（シンガポール証券取引所上場企業 Addvalue Technologies Ltd.株式：125,802,352株）について、2026年４月末時点の評価額は2,254百万円（2026年1月末比：＋1,178百万円）となっており、当社では国際会計基準への移行に伴い、2026年10月期からこの評価差益を金融収益として計上しております。これにより、親会社株主に帰属する当期利益の増加を見込んでおります。なお、今回の通期連結業績予想においては、当該海外株式の評価益について、2026年４月末時点での水準から実効税額相当額を減じた金額を当期利益として計上しております。各四半期決算時点の評価損益で洗い替えを行い、開示基準に抵触する変動が生じた場合には、その都度業績予想を修正してまいります。親会社株主に帰属する当期利益については、税効果会計に関する見積りの影響等により変動する可能性がございますので、重要な影響を与える新たな事象が発生しましたら速やかに公表させていただきます。当社グループは、引き続き更なる企業価値の拡大並びに利益の最大化に努めてまいります。", null, "CurrentYearDuration"], ["PreviousReportingDateOfDividendForecast", "PreviousReportingDateOfDividendForecast", "tse-ed-t", "当期末", null, "（2025年12月15日発表）", null, "CurrentYearInstant_AnnualMember_NonConsolidatedMember_PreviousMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 0, "0.00", "JPYPerShares", "CurrentYearDuration_SecondQuarterMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 5, "5.00", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 5, "5.00", "JPYPerShares", "CurrentYearDuration_AnnualMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 10, "10.00", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 10, "10.00", "JPYPerShares", "CurrentYearDuration_AnnualMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "当期", 0, "0.00", "JPYPerShares", "CurrentYearDuration_SecondQuarterMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 0, "0.00", "JPYPerShares", "PriorYearDuration_SecondQuarterMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 5, "5.00", "JPYPerShares", "PriorYearDuration_YearEndMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 5, "5.00", "JPYPerShares", "PriorYearDuration_AnnualMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForDividendForecastCorrection", "ReasonForDividendForecastCorrection", "tse-ed-t", "当期", null, "当社は、株主の皆様への利益還元を重要な経営課題の一つと位置付けております。2026年10月期の業績予想が前回予想を上回る見込みであることを踏まえ、株主還元の充実を図るため、期末配当予想を１株当たり５円から10円に修正いたします。(注)上記の業績予想につきましては、現時点で入手可能な情報に基づき作成したものであり、実際の業績は、今後様々な要因により予想数値と異なる可能性があります。", null, "CurrentYearDuration"], ["FiscalYearEnd", "FiscalYearEnd", "tse-ed-t", "当期末", null, "2026-10-31", null, "CurrentYearInstant"]]}}