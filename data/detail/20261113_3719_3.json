OfDividendForecast", "tse-ed-t", "当期末", null, "（令和８年２月13日発表）", null, "CurrentYearInstant_AnnualMember_NonConsolidatedMember_PreviousMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 3, "3.00", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 3, "3.00", "JPYPerShares", "CurrentYearDuration_AnnualMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 0, "0.00", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 0, "0.00", "JPYPerShares", "CurrentYearDuration_AnnualMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "当期", 0, "0.00", "JPYPerShares", "CurrentYearDuration_SecondQuarterMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 0, "0.00", "JPYPerShares", "PriorYearDuration_SecondQuarterMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 3, "3.00", "JPYPerShares", "PriorYearDuration_YearEndMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 3, "3.00", "JPYPerShares", "PriorYearDuration_AnnualMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForDividendForecastCorrection", "ReasonForDividendForecastCorrection", "tse-ed-t", "当期", null, "当社は、株主の皆様への利益還元を重要な経営課題の一つと認識しております。しかしながら、今回の業績予想の下方修正を踏まえ、事業基盤の強化を優先する必要があると判断したことから、誠に遺憾ではございますが、令和８年12月期の期末配当予想を無配へ修正することといたしました。株主の皆様には深くお詫び申し上げますとともに、早期の業績回復及び企業価値向上に努めてまいりますので、何卒ご理解賜りますようお願い申し上げます。※上記の業績予想は、本資料の発表日現在において入手可能な情報に基づき作成したものであり、実際の業績は今後さまざまな要因により予想数値と異なる結果となる可能性があります。以 上", null, "CurrentYearDuration"], ["FiscalYearEnd", "FiscalYearEnd", "tse-ed-t", "当期末", null, "2026-12-31", null, "CurrentYearInstant"]]}}