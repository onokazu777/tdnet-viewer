, ["ChangeInNetSales", "ChangeInNetSales", "tse-ed-t", "予想", -0.255, "25.5", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "前期", 2508000000, "2,508", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "前期", -3822000000, "3,822", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "前期", -3712000000, "3,712", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["ProfitAttributableToOwnersOfParent", "ProfitAttributableToOwnersOfParent", "tse-ed-t", "前期", -4057000000, "4,057", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "前期", -65.84, "65.84", "JPYPerShares", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForForecastCorrection", "ReasonForForecastCorrection", "tse-ed-t", "当期", null, "当社は、2026年９月29日に公表した「AxelGlobe事業の小型衛星「GRUS-3」の不具合に関するお知らせ」において、当社連結子会社である株式会社アクセルスペース（以下、「アクセルスペース」という。）が同年７月７日（日本時間）に打上げた小型衛星「GRUS-3」７機のうち、４機において、高速通信系統に不具合が確認されたことを受け、高速通信系統の復旧及び予定していた商用運用が困難であるという結論が報告されたことを公表しておりました。その後も原因究明を進めておりましたが、高速通信系統の不具合は恒久故障であり、不具合が確認された４機については予定していた高速通信系統での画像データのダウンロードによる商用運用は困難であると判断し、2027年５月期第１四半期に減損損失1,879百万円を特別損失として計上することといたしました。また、当社は、本日公表の「（開示事項の経過）Pale Blue社との軌道上実証サービス提供契約に関する協議開始のお知らせ」において、アクセルスペースが、2025年12月16日付「Pale Blue社との軌道上実証サービス提供に関する契約締結のお知らせ」にて公表した、株式会社Pale Blue（以下、「Pale Blue社」という。）との軌道上実証サービス提供に関する契約について、本契約の解除に関する書面を受領し、10月６日より協議を開始した旨を公表しました。これらを踏まえ、本日開催の取締役会において、2026年７月14日に公表した2027年５月期通期（2026年６月１日～2027年５月31日）の業績予想を修正することを決議いたしましたので、お知らせいたします。", null, "CurrentYearDuration"], ["FiscalYearEnd", "FiscalYearEnd", "tse-ed-t", "当期末", null, "2027-05-31", null, "CurrentYearInstant"]]}}