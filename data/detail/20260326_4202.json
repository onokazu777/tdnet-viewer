期延長と需給バランスの見通しから、稼働予定を2027年３月期第４四半期から2028年３月期中へ変更し、この間に安全品質をより向上させる対応を実施してまいります。2．　2026年３月期通期連結業績予想の修正（2025年４月１日～2026年３月31日）", null, "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "予想", 583000000000, "583,000", "JPY", "CurrentYearDuration_ConsolidatedMember_PreviousMember_ForecastMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "予想", 46500000000, "46,500", "JPY", "CurrentYearDuration_ConsolidatedMember_PreviousMember_ForecastMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "予想", 47500000000, "47,500", "JPY", "CurrentYearDuration_ConsolidatedMember_PreviousMember_ForecastMember"], ["NetIncome", "NetIncome", "tse-ed-t", "予想", 50000000000, "50,000", "JPY", "CurrentYearDuration_ConsolidatedMember_PreviousMember_ForecastMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "予想", 188.33, "188.33", "JPYPerShares", "CurrentYearDuration_ConsolidatedMember_PreviousMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "予想", 576000000000, "576,000", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "予想", 41000000000, "41,000", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "予想", 43000000000, "43,000", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["NetIncome", "NetIncome", "tse-ed-t", "予想", 10000000000, "10,000", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "予想", 38.89, "38.89", "JPYPerShares", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["AmountChangeNetSales", "AmountChangeNetSales", "tse-ed-t", "予想", -7000000000, "7,000", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["AmountChangeOperatingIncome", "AmountChangeOperatingIncome", "tse-ed-t", "予想", -5500000000, "5,500", "JPY", "CurrentYear