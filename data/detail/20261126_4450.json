etSales", "tse-ed-t", "予想", 0.022, "2.2", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOperatingIncome", "ChangeInOperatingIncome", "tse-ed-t", "予想", 0.345, "34.5", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOrdinaryIncome", "ChangeInOrdinaryIncome", "tse-ed-t", "予想", 0.436, "43.6", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInProfitAttributableToOwnersOfParent", "ChangeInProfitAttributableToOwnersOfParent", "tse-ed-t", "予想", 0, "0.0", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "前期", 8099000000, "8,099", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "前期", 713000000, "713", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "前期", 703000000, "703", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["ProfitAttributableToOwnersOfParent", "ProfitAttributableToOwnersOfParent", "tse-ed-t", "前期", 388000000, "388", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "前期", 127.5, "127.50", "JPYPerShares", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForForecastCorrection", "ReasonForForecastCorrection", "tse-ed-t", "当期", null, "２．\t修正の理由　EBITDA、営業利益および経常利益は、売上高の増加が一定程度となる一方、グループ全体での高単価案件へのシフトと人的交流の促進により粗利益が大幅に増加することで、各利益が予想を大幅に上回ることを見込んでおります。　一方、親会社株主に帰属する当期純利益は、据え置きを見込んでおり、当社グループが保有するRPA関連サービスの販売用ライセンス在庫の将来の回収可能性を検討した結果、第4四半期に特別損失（減損損失）1.3～1.4億円を計上する見込みとなります。３．\t特別損失（減損損失）の計上について　当社グループは、UiPath関連ビジネスの成長を見込み、過年度において複数年にわたるライセンスを仕入れてまいりました。当該ライセンスの一部については、契約期間である4年間のうち、最終年度（2027年4月～2028年3月）に費用負担が大きくなる契約条件となっております。加えて、生成AIの急速な進展に伴い、企業における業務自動化ニーズや技術選定の考え方が変化しており、UiPathライセンスの販売は当初想定していた成長率を下回る状況となっております。こうした市場環境の変化を踏まえ、当社グループはUiPath関連ビジネスの成長戦略を見直し、ライセンス販売数量の拡大を中心とした取り組みから、顧客課題の解決に直結するデリバリーサービスの強化や、他のソリューションとのクロスセル拡大を重視する方針へ転換しております。今後は、生成AIによる柔軟な判断・推論と、RPAによる高い再現性・安定性を組み合わせた業務自動化を推進し、お客様の生産性向上に貢献するとともに、中長期的な事業成長を目指してまいります。　こうした事業環境の変化や事業方針の転換を踏まえ、当該ライセンスの契約条件に基づく費用負担の構造および今後の販売見通しを勘案した結果、保有するライセンス在庫について減損損失を計上することといたしました。　なお、当該複数年契約については、今回の減損損失の影響を含めても、契約期間全体では十分な利益を確保できる見通しです。本件は、契約期間全体の採算性とは別に、事業環境の変化および将来の販売見通しを踏まえ、現時点で保有するライセンス在庫の会計上の評価を見直したことによるものです。　当社グループは今後、複数年契約に係るライセンス仕入れにおいて、販売計画との整合性や在庫リスク管理をこれまで以上に重視するとともに、年度ごとの費用負担の平準化にも配慮し、収益性および資産効率の向上に努めてまいります。（注）上記の予想数値等の将来に関する記述は、当社が現在入手している情報及び合理的であると判断する一定の前提に基づいており、その達成を当社として約束する趣旨のものではありません。また、実際の業績等は様々な要因により大きく異なる可能性があります。", null, "CurrentYearDuration"], ["FiscalYearEnd", "FiscalYearEnd", "tse-ed-t", "当期末", null, "2026-12-31", null, "CurrentYearInstant"]]}}