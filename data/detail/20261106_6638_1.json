angeInNetSales", "ChangeInNetSales", "tse-ed-t", "予想", 0.004, "0.4", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOperatingIncome", "ChangeInOperatingIncome", "tse-ed-t", "予想", 0.084, "8.4", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOrdinaryIncome", "ChangeInOrdinaryIncome", "tse-ed-t", "予想", 0.14, "14.0", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInProfitAttributableToOwnersOfParent", "ChangeInProfitAttributableToOwnersOfParent", "tse-ed-t", "予想", 0.098, "9.8", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "前期", 83725000000, "83,725", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "前期", 9431000000, "9,431", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "前期", 8907000000, "8,907", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["ProfitAttributableToOwnersOfParent", "ProfitAttributableToOwnersOfParent", "tse-ed-t", "前期", 6741000000, "6,741", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "前期", 233.01, "233.01", "JPYPerShares", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForForecastCorrection", "ReasonForForecastCorrection", "tse-ed-t", "当期", null, "中間連結業績につきましては、売上高は、インク販売が各市場で大幅伸長したことや前期から当期にかけて市場投入したSG・IP・TA市場向け製品の販売が牽引しました。加えて、為替の円安によるプラス効果もあり前回予想を上回る見込みとなりました。利益につきましては、原価改善活動の効果や製品ミックスの改善並びに為替の寄与に加え、米国の追加関税の還付もあり各段階利益ともに前回予想を大幅に上回る見通しとなりました。　通期連結業績につきましては、中東情勢などグローバルでの市場環境等は引き続き不確実性が高いものと想定しております。下期の売上高は、製品市場別及びエリア別の動向並びに新製品投入の見通しを踏まえて見直し、利益につきましては、上期見通しにおける前回予想からの上振れ分を反映する一方、現在推進しております中長期成長戦略MI30（Mimaki Innovation 30）に掲げる新たな領域への追加的な成長投資を織り込み、通期連結業績予想を修正いたします。　なお、連結業績予想の前提となる第３四半期以降の主要な為替レートは、１米ドル：146円、１ユーロ：170円とし、前回予想から変更はありません。※ 本資料に記載されている業績見通し等の将来に関する記述は、当社が現在入手している情報及び合理的であると判断する一定の前提に基づいており、実際の業績等は様々な要因により大きく異なる可能性があります。", null, "CurrentYearDuration"], ["FiscalYearEnd", "FiscalYearEnd", "tse-ed-t", "当期末", null, "2027-03-31", null, "CurrentYearInstant"]]}}