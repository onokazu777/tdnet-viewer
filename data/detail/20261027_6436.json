hangeInOrdinaryIncome", "tse-ed-t", "予想", -0.208, "20.8", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInNetIncome", "ChangeInNetIncome", "tse-ed-t", "予想", -0.234, "23.4", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "前期", 76689000000, "76,689", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "前期", 12912000000, "12,912", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "前期", 17695000000, "17,695", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["NetIncome", "NetIncome", "tse-ed-t", "前期", 14393000000, "14,393", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "前期", 204.58, "204.58", "JPYPerShares", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForForecastCorrection", "ReasonForForecastCorrection", "tse-ed-t", "当期", null, "当中間連結会計期間においては、国内グループ会社が堅調に推移した一方、アマノ単体では、情報システムにおいて、前期のWindows 10サポート終了に伴う更新需要の剥落に加え、2025年12月にリリースした新製品「TimePro-eX」が中堅・大企業を主な対象としていることから、商談開始から売上計上までのリードタイムが長期化する傾向にあり、新製品の売上寄与が当初の想定を下回りました。また、製品リリースに伴うソフトウェア償却費が増加したことから、収益性は前年同期の水準には届きませんでした。パーキングシステムでは、カメラ式駐車場やキャッシュレス決済などの新商材の拡販が本格化するには至っておらず、環境システムでは、受注残の売上計上が下期に偏重しています。加えて、海外グループ会社についても、北米およびアジア地域の業績が低調に推移していることから、売上高および利益が当初予想を下回る見込みとなりました。通期業績につきましては、国内グループ会社の堅調な推移に加え、アマノ単体のパーキングシステムおよび環境システムにおける受注残の着実な売上計上等を見込むものの、収益の柱であるアマノ単体の情報システムの業績回復には時間が掛かることから、中間期までの業績進捗の遅れを当期中に補うことは困難と判断し、連結業績予想を修正するものです。なお、情報システムでは、AI機能を搭載した新製品に係る商談が徐々に進展しており、パーキングシステムにおいても、新商材の販売拡大に向けた取り組みを進めています。これらの成長施策を着実に推進することで、来期以降の利益成長基調への回帰を目指してまいります。", null, "CurrentYearDuration"], ["FiscalYearEnd", "FiscalYearEnd", "tse-ed-t", "当期末", null, "2027-03-31", null, "CurrentYearInstant"]]}}