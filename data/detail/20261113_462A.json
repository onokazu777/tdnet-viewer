00, "272", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["AmountChangeProfitAttributableToOwnersOfParent", "AmountChangeProfitAttributableToOwnersOfParent", "tse-ed-t", "予想", -442000000, "442", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInNetSales", "ChangeInNetSales", "tse-ed-t", "予想", -0.198, "19.8", "Pure", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["営業収益", "OperatingRevenue1", "tse-ed-t", "前期", 2501000000, "2,501", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "前期", 213000000, "213", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "前期", 211000000, "211", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["ProfitAttributableToOwnersOfParent", "ProfitAttributableToOwnersOfParent", "tse-ed-t", "前期", 395000000, "395", "JPY", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "前期", 17.35, "17.35", "JPYPerShares", "PriorYearDuration_ConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForForecastCorrection", "ReasonForForecastCorrection", "tse-ed-t", "当期", null, "〔プライマリー領域〕　前回(2026年６月12日付)の修正時には、下期において「FUNDINNO PLUS+」を中心としたGMV(流通取引総額)の積み上げに取り組む計画としておりました。しかしながら、下期においても、発行会社と投資家のバリュエーションに対する認識の乖離などの要因により大型資金調達案件の創出は想定を下回りました。また、投資家の選別姿勢も強まる中、期末まで募集を続けた主要案件の一部は、募集期間内に必要な成約水準に達しませんでした。この結果、成約件数・成約額とも当社想定を下回って推移し、プライマリー領域の営業収益は前回発表予想を下回る見込みです。〔グロース領域〕　グロース領域は概ね前回発表予想の水準で推移したものの、「MUFG FUNDOOR」における受託開発案件の受注・進行が想定を下回ったこと、人材紹介「FUNDINNO GROWTH」における成約の一部が2027年10月期以降にずれ込んだことにより、前回発表予想をやや下回る見込みです。〔セカンダリー領域〕　セカンダリー領域で取り扱う未上場株式の流動化支援等の取引は、主としてプライマリー領域の案件組成の過程から派生する個別性の高い取引であります。前回修正時には、上期に成立した大型の流動化支援取引の実績を踏まえ、下期においても同水準の取引の成立を想定しておりましたが、当該取引は発行会社及び株主の個別の状況に依存する性質上、下期においては同種の取引の成立に至りませんでした。この結果、セカンダリー領域の営業収益は前回発表予想を下回る見込みです。　これらの結果、通期の営業収益は前回発表予想を下回る見込みとなりました。　営業利益は、「FUNDINNO PLUS+」のGMVが想定を下回ったことに伴いパートナー企業との連携費用が減少したことに加え、新規採用抑制による人件費や人材採用費の抑制等、全体的なコスト削減に努めたものの、営業収益の減少を補うには至らず、前回発表予想を下回る見通しであります。　経常利益は、営業損失の拡大に伴い前回発表予想を下回る見通しであります。また、親会社株主に帰属する当期純利益は、経常損失の拡大に加え、上記１．に記載のとおり固定資産の減損損失を特別損失に計上することから、前回発表予想を下回る見通しであります。　なお、2026年10月期の確定した業績につきましては、2026年12月11日に予定しております決算発表において開示いたします。", null, "CurrentYearDuration"], ["FiscalYearEnd", "FiscalYearEnd", "tse-ed-t", "当期末", null, "2026-10-31", null, "CurrentYearInstant"]]}}