0000000000001, "85.7", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInOrdinaryIncome", "ChangeInOrdinaryIncome", "tse-ed-t", "予想", 0.429, "42.9", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["ChangeInNetIncome", "ChangeInNetIncome", "tse-ed-t", "予想", 0.5, "50.0", "Pure", "CurrentYearDuration_NonConsolidatedMember_CurrentMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "前期", 31631000000, "31,631", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "前期", 1050000000, "1,050", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "前期", 1885000000, "1,885", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["NetIncome", "NetIncome", "tse-ed-t", "前期", 1511000000, "1,511", "JPY", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "前期", 98.46, "98.46", "JPYPerShares", "PriorYearDuration_NonConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForForecastCorrection", "ReasonForForecastCorrection", "tse-ed-t", "当期", null, "１．連結業績予想の修正理由　通期の見通しにつきましては、当中間連結業績において、マレーシアにおけるデータセンターの電気設備工事が計画を上回って進捗したことに加え、手持ち工事の進捗見込みを踏まえ、売上高は800億円を見込んでいます。　利益面では、当中間連結業績において、マレーシアの売上高の増加に伴い売上総利益が増加したことに加え、以下の「２．個別業績予想の修正理由」に記載の影響及び手持ち工事の進捗から下期の営業利益は上期を下回る見通しですが、通期では前期比で増益を見込んでおり、営業利益35億円、経常利益43億円、親会社株主に帰属する当期純利益31億円となり、前回公表の通期連結業績予想からそれぞれ増加する見込みです。２．個別業績予想の修正理由　通期の見通しにつきましては、当中間個別業績において、当初公表の業績予想から若干増加したことに加え、手持ち工事の進捗見込みを踏まえ、売上高は340億円を見込んでいます。　利益面では、当中間個別業績において、原価低減に努めた結果、大型工事において計画比で売上総利益が増加したことに加え、太陽光発電所工事の工事代金の回収に伴う貸倒引当金の戻入３億81百万円を計上したことから販売費及び一般管理費が減少し、営業利益が増加しました。さらに手持ち工事の状況から営業利益13億円が見込まれ、受取地代家賃が堅調に推移することを踏まえ、経常利益20億円、当期純利益15億円となり、前回公表の通期個別業績予想からそれぞれ増加する見込みです。", null, "CurrentYearDuration"], ["PreviousReportingDateOfDividendForecast", "PreviousReportingDateOfDividendForecast", "tse-ed-t", "当期末", null, "（2026年８月10日発表）", null, "CurrentYearInstant_AnnualMember_NonConsolidatedMember_PreviousMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 55, "55.00", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 55, "55.00", "JPYPerShares", "CurrentYearDuration_AnnualMember_NonConsolidatedMember_PreviousMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 80, "80.00", "JPYPerShares", "CurrentYearDuration_YearEndMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "予想", 80, "80.00", "JPYPerShares", "CurrentYearDuration_AnnualMember_NonConsolidatedMember_CurrentMember_ForecastMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 65, "65.00", "JPYPerShares", "PriorYearDuration_YearEndMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["1株当たり配当額", "DividendPerShare", "tse-ed-t", "前期", 65, "65.00", "JPYPerShares", "PriorYearDuration_AnnualMember_NonConsolidatedMember_CurrentMember_ResultMember"], ["ReasonForDividendForecastCorrection", "ReasonForDividendForecastCorrection", "tse-ed-t", "当期", null, "当社は、安定した財務基盤の堅持、「より堅固な事業基盤の構築」に必要となる成長投資への必要資金を確保した上で、適切な株主還元を行うことを基本的な方針としております。　また、具体的には、配当性向は30％を目途として、ＤＯＥにつきましては、2.0％以上を確保することを基本方針とし、財務状況や業績に応じて柔軟に対応することとしております。　2027年３月期の期末配当金につきましては、上記方針を踏まえつつ、業績予想の修正に伴い、１株当たり55円から25円増配し、80円に修正することといたしました。（注）上記予想は、本資料発表日現在において入手可能な情報を前提としております。実際の業績は今後様々な要因によって予想数値と異なる場合があります。", null, "CurrentYearDuration"], ["FiscalYearEnd", "FiscalYearEnd", "tse-ed-t", "当期末", null, "2027-03-31", null, "CurrentYearInstant"]]}}