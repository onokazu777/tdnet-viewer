えた研究開発投資の効率化および2024年5月に公表した縮減方針に基づく政策保有株式売却等を踏まえ、2026年3月期の業績予想との差異が見込まれるため、2025年9月26日に公表した2026年3月期通期（2025年4月1日～2026年3月31日）の連結業績予想を下記のとおり修正いたしました。", null, "CurrentYearInstant"], ["売上高", "NetSales", "tse-ed-t", "予想", 86300000000, "86,300", "JPY", "CurrentYearDuration_ConsolidatedMember_PreviousMember_ForecastMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "予想", 2100000000, "2,100", "JPY", "CurrentYearDuration_ConsolidatedMember_PreviousMember_ForecastMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "予想", 2800000000, "2,800", "JPY", "CurrentYearDuration_ConsolidatedMember_PreviousMember_ForecastMember"], ["ProfitAttributableToOwnersOfParent", "ProfitAttributableToOwnersOfParent", "tse-ed-t", "予想", 2300000000, "2,300", "JPY", "CurrentYearDuration_ConsolidatedMember_PreviousMember_ForecastMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "予想", 60.74, "60.74", "JPYPerShares", "CurrentYearDuration_ConsolidatedMember_PreviousMember_ForecastMember"], ["売上高", "NetSales", "tse-ed-t", "予想", 76900000000, "76,900", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["営業利益", "OperatingIncome", "tse-ed-t", "予想", -900000000, "900", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["経常利益", "OrdinaryIncome", "tse-ed-t", "予想", -200000000, "200", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["ProfitAttributableToOwnersOfParent", "ProfitAttributableToOwnersOfParent", "tse-ed-t", "予想", 2100000000, "2,100", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["NetIncomePerShare", "NetIncomePerShare", "tse-ed-t", "予想", 55.39, "55.39", "JPYPerShares", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["AmountChangeNetSales", "AmountChangeNetSales", "tse-ed-t", "予想", -9400000000, "9,400", "JPY", "CurrentYearDuration_ConsolidatedMember_CurrentMember_ForecastMember"], ["AmountChangeOperatingIncome", "AmountChangeOperatingIncome", "tse-ed-t